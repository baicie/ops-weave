{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "source-connection-check",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "checkId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "sourceInstanceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}(?![\\s\\S])"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z(?![\\s\\S])"
    },
    "dataMode": {
      "enum": ["labeled-fixture", "zabbix-jsonrpc", "closed"]
    },
    "reachable": {
      "type": "boolean"
    },
    "statusCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[ -~]{1,64}(?![\\s\\S])"
    },
    "reportedVersion": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[ -~]{1,32}(?![\\s\\S])"
    }
  },
  "required": [
    "checkId",
    "sourceInstanceId",
    "actor",
    "checkedAt",
    "dataMode",
    "reachable",
    "statusCode",
    "reportedVersion"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "reachable": {
            "const": false
          }
        },
        "required": ["reachable"]
      },
      "then": {
        "properties": {
          "reportedVersion": {
            "type": "null"
          }
        }
      }
    }
  ]
}
