{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Entity model version pin",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "revision", "digest"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(builtin|custom)\\.[a-z][a-z0-9_]{0,47}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
