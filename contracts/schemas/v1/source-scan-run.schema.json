{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "source-scan-run",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "syncRunId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "objectType": {
      "enum": ["host", "item"]
    },
    "status": {
      "enum": ["RUNNING", "SUCCEEDED", "FAILED"]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z(?![\\s\\S])"
    },
    "completedAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z(?![\\s\\S])"
    },
    "cursor": {
      "type": ["string", "null"],
      "maxLength": 256,
      "pattern": "^[ -~]{0,256}$"
    },
    "pages": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "fetched": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "accepted": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rejected": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "snapshotComplete": {
      "type": "boolean"
    },
    "dataMode": {
      "enum": ["labeled-fixture", "zabbix-jsonrpc", "closed"]
    },
    "scanConsistency": {
      "enum": ["offset-scan-attempt", "hostid-watermark-snapshot", "itemid-watermark-snapshot"]
    },
    "failureCode": {
      "enum": [
        "SOURCE_SCAN_BUSY",
        "SOURCE_SCAN_LOST",
        "SOURCE_SCAN_DEADLINE",
        "SOURCE_SCAN_LIMIT",
        "SOURCE_SCAN_UNVERIFIED",
        "SOURCE_FETCH_FAILED",
        "RAW_PERSIST_FAILED",
        "MAPPING_FAILED",
        "INVENTORY_WRITE_FAILED",
        "CHECKPOINT_FAILED",
        "PAGE_NOT_ADVANCED",
        "PAGE_LIMIT_EXCEEDED"
      ]
    },
    "failureSummary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
    },
    "pipelineVersion": {
      "$ref": "pipeline-ref.schema.json"
    }
  },
  "required": [
    "syncRunId",
    "objectType",
    "status",
    "startedAt",
    "completedAt",
    "cursor",
    "pages",
    "fetched",
    "accepted",
    "rejected",
    "snapshotComplete",
    "dataMode",
    "scanConsistency"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "RUNNING"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "snapshotComplete": {
            "const": false
          },
          "completedAt": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "FAILED"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "snapshotComplete": {
            "const": false
          },
          "completedAt": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "SUCCEEDED"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "snapshotComplete": {
            "const": true
          },
          "completedAt": {
            "type": "string"
          }
        }
      }
    }
  ]
}
