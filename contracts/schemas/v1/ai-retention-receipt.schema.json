{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "storage",
    "state",
    "tenantId",
    "actor",
    "command",
    "preview",
    "completedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "storage": {
      "const": "postgres"
    },
    "state": {
      "const": "COMPLETED"
    },
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$(?![\\s\\S])"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$(?![\\s\\S])"
    },
    "command": {
      "$ref": "ai-retention-apply.schema.json"
    },
    "preview": {
      "$ref": "ai-retention-preview.schema.json#/$defs/preview"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$(?![\\s\\S])"
    }
  }
}
