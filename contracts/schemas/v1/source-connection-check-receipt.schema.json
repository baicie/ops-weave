{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "source-connection-check-receipt",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "storage": {
      "enum": ["postgres", "memory"]
    },
    "dataMode": {
      "const": "connection-check"
    },
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
    },
    "sourceInstanceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}(?![\\s\\S])"
    },
    "check": {
      "$ref": "source-connection-check.schema.json"
    }
  },
  "required": ["schemaVersion", "storage", "dataMode", "tenantId", "sourceInstanceId", "check"]
}
