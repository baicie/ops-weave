{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "from": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999999999
    },
    "till": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999999999
    },
    "afterEventId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": [
    "from",
    "till",
    "afterEventId",
    "limit"
  ]
}
