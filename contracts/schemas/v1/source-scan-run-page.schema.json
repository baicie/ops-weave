{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "source-scan-run-page",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "storage": {
      "enum": ["postgres", "memory"]
    },
    "dataMode": {
      "const": "scan-log"
    },
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
    },
    "sourceInstanceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}(?![\\s\\S])"
    },
    "objectType": {
      "enum": ["host", "item"]
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "after": {
      "type": ["string", "null"],
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9_-]{0,192}$"
    },
    "hasMore": {
      "type": "boolean"
    },
    "nextCursor": {
      "type": ["string", "null"],
      "maxLength": 192,
      "pattern": "^[A-Za-z0-9_-]{0,192}$"
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "description": "Budget for ended, unpinned scan runs and their current count in this scope. RUNNING and pinned runs are protected, excluded from retained, and may still appear in items. This is not a bound on total stored rows. A read never prunes.",
      "properties": {
        "maxRunsPerScope": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maxRunsPerTenant": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "retained": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      },
      "required": ["maxRunsPerScope", "maxRunsPerTenant", "retained"]
    },
    "items": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "source-scan-run.schema.json"
      }
    }
  },
  "required": [
    "schemaVersion",
    "storage",
    "dataMode",
    "tenantId",
    "sourceInstanceId",
    "objectType",
    "limit",
    "after",
    "hasMore",
    "nextCursor",
    "retention",
    "items"
  ]
}
