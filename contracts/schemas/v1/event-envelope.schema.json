{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EventEnvelope v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "minLength": 1
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "sourceInstanceId": {
      "type": "string",
      "minLength": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "ingestedAt": {
      "type": "string",
      "format": "date-time"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "replay": {
      "type": "boolean"
    },
    "data": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "tenantId",
    "sourceInstanceId",
    "occurredAt",
    "observedAt",
    "ingestedAt",
    "replay",
    "data"
  ]
}
