{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v1/source-setup-confirmed.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "setup",
    "workflow"
  ],
  "properties": {
    "setup": {
      "$ref": "source-setup.schema.json"
    },
    "workflow": {
      "oneOf": [
        {
          "$ref": "../v2/workflow-entry.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "setup": {
            "properties": {
              "initialTarget": {
                "type": "object"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "workflow": {
            "type": "object"
          }
        }
      }
    }
  ]
}
