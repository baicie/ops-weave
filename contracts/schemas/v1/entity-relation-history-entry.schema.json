{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Entity relation history entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["relation", "closeReason"],
  "properties": {
    "relation": {"$ref": "entity-relation.schema.json"},
    "closeReason": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 256}, {"type": "null"}]}
  },
  "allOf": [
    {
      "if": {"properties": {"closeReason": {"type": "string"}}},
      "then": {"properties": {"relation": {"required": ["validTo"], "properties": {"validTo": {"type": "string", "format": "date-time"}}}}}
    }
  ]
}
