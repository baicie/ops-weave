{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v1/model-extension-command.schema.json",
  "title": "Tenant model extension draft command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "base",
    "fields",
    "expectedEditVersion"
  ],
  "properties": {
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(builtin|custom)\\.[a-z][a-z0-9_]{0,47}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "fields": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "model-extension-field.schema.json"
      }
    },
    "expectedEditVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    }
  }
}
