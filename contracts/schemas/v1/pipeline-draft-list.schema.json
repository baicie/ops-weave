{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "storage": {
      "enum": [
        "memory",
        "postgres"
      ]
    },
    "items": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target": {
            "$ref": "pipeline-ref.schema.json"
          },
          "editVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "target",
          "editVersion",
          "updatedAt"
        ]
      }
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "storage",
    "items",
    "truncated"
  ]
}
