{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "knowledgeMode": {
      "const": "current"
    },
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "incidentId": {
      "type": "string",
      "format": "uuid"
    },
    "sessionId": {
      "type": "string",
      "format": "uuid"
    },
    "timeRange": {
      "$ref": "tool-time-window.schema.json"
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "builtAt": {
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "platform-evidence.schema.json"
      }
    },
    "missingData": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
      }
    }
  },
  "required": [
    "schemaVersion",
    "knowledgeMode",
    "runId",
    "tenantId",
    "incidentId",
    "sessionId",
    "timeRange",
    "asOf",
    "builtAt",
    "evidence",
    "missingData"
  ]
}
