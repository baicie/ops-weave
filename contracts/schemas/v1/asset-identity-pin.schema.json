{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "asset-identity-pin",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$(?![\\s\\S])"
    },
    "value": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?![\\s\\S])"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "id",
    "namespace",
    "value",
    "version"
  ]
}
