{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "status": {
      "enum": [
        "OPEN",
        "INVESTIGATING",
        "MITIGATED",
        "RESOLVED",
        "CLOSED"
      ]
    },
    "severity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceInstanceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sourceContract": {
            "const": "zabbix-7.0-event-v1"
          },
          "dataMode": {
            "enum": [
              "labeled-fixture",
              "zabbix-jsonrpc"
            ]
          },
          "problemEventId": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "state": {
            "enum": [
              "ACTIVE",
              "RECOVERED",
              "RECOVERY_UNKNOWN"
            ]
          },
          "severity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastReceivedAt": {
            "type": "string",
            "format": "date-time"
          },
          "suppressed": {
            "type": "boolean"
          },
          "recoveryEventId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,19}$"
              },
              {
                "const": ""
              }
            ]
          },
          "recoveredAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "const": ""
              }
            ]
          },
          "overlapsWindow": {
            "type": "boolean"
          }
        },
        "required": [
          "sourceInstanceId",
          "sourceContract",
          "dataMode",
          "problemEventId",
          "title",
          "state",
          "severity",
          "occurredAt",
          "observedAt",
          "lastReceivedAt",
          "suppressed",
          "recoveryEventId",
          "recoveredAt",
          "overlapsWindow"
        ]
      },
      "maxItems": 50,
      "minItems": 1
    }
  },
  "required": [
    "title",
    "status",
    "severity",
    "version",
    "problems"
  ]
}
