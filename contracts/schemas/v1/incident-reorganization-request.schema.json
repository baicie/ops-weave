{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "requestKey": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "MERGE",
        "SPLIT"
      ]
    },
    "sourceIncidentId": {
      "type": "string",
      "format": "uuid"
    },
    "expectedSourceVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740990
    },
    "targetIncidentId": {
      "type": "string",
      "format": "uuid"
    },
    "expectedTargetVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740990
    },
    "problemKeys": {
      "type": "array",
      "minItems": 0,
      "maxItems": 49,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceInstanceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "problemEventId": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          }
        },
        "required": [
          "sourceInstanceId",
          "problemEventId"
        ]
      }
    },
    "title": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 300
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "required": [
    "requestKey",
    "kind",
    "sourceIncidentId",
    "expectedSourceVersion",
    "targetIncidentId",
    "expectedTargetVersion",
    "problemKeys",
    "title",
    "reason"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "MERGE"
          }
        }
      },
      "then": {
        "properties": {
          "expectedTargetVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740990
          },
          "problemKeys": {
            "maxItems": 0
          },
          "title": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "expectedTargetVersion": {
            "const": 0
          },
          "problemKeys": {
            "minItems": 1
          },
          "title": {
            "type": "string"
          }
        }
      }
    }
  ]
}
