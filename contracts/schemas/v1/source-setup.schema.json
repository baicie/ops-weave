{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v1/source-setup.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "source",
    "connectionDigest",
    "initialTarget",
    "digest",
    "createdAt",
    "workflowId",
    "dataMode"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "instanceId"
      ],
      "properties": {
        "kind": {
          "enum": [
            "MANUAL_SAMPLE",
            "ZABBIX_HOST"
          ]
        },
        "instanceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "MANUAL_SAMPLE"
              }
            }
          },
          "then": {
            "properties": {
              "instanceId": {
                "const": "manual"
              }
            }
          }
        }
      ]
    },
    "connectionDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "initialTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(builtin|custom)\\.[a-z][a-z0-9_]{0,47}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "workflowId": {
      "type": "string",
      "pattern": "^source-[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "dataMode": {
      "enum": [
        "fixture",
        "zabbix-jsonrpc",
        "MANUAL_SAMPLE"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "kind": {
                "const": "MANUAL_SAMPLE"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "dataMode": {
            "const": "MANUAL_SAMPLE"
          }
        }
      },
      "else": {
        "properties": {
          "dataMode": {
            "enum": [
              "fixture",
              "zabbix-jsonrpc"
            ]
          }
        }
      }
    }
  ]
}
