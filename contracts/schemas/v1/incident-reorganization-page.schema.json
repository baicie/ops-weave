{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "storage": {
      "enum": [
        "memory",
        "postgres"
      ]
    },
    "incidentId": {
      "type": "string",
      "format": "uuid"
    },
    "after": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 25
    },
    "items": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "$ref": "incident-reorganization.schema.json"
      }
    },
    "nextCursor": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  },
  "required": [
    "storage",
    "incidentId",
    "after",
    "limit",
    "items",
    "nextCursor"
  ]
}
