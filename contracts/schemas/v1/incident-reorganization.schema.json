{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "request": {
      "$ref": "incident-reorganization-request.schema.json"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sourceVersion": {
      "type": "integer",
      "minimum": 2
    },
    "targetVersion": {
      "type": "integer",
      "minimum": 1
    },
    "movedProblems": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceInstanceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "problemEventId": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          }
        },
        "required": [
          "sourceInstanceId",
          "problemEventId"
        ]
      }
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schemaVersion",
    "request",
    "actor",
    "sourceVersion",
    "targetVersion",
    "movedProblems",
    "occurredAt"
  ]
}
