{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opsweave.invalid/v1/metric-definition-page",
  "type": "object", "additionalProperties": false, "required": ["items"],
  "properties": {
    "items": {"type": "array", "maxItems": 1000, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["tenantId", "metricKey", "displayName", "unit", "valueType", "metricType", "dimensionSchema"],
      "properties": {
        "tenantId": {"type": "string", "minLength": 1, "maxLength": 128},
        "metricKey": {"type": "string", "pattern": "^[A-Za-z0-9_.:/%-]{1,128}$"},
        "displayName": {"type": "string", "minLength": 1, "maxLength": 256},
        "unit": {"type": "string", "maxLength": 64},
        "valueType": {"enum": ["INTEGER", "UNSIGNED", "FLOAT", "DOUBLE", "STRING", "LOG"]},
        "metricType": {"enum": ["GAUGE", "COUNTER"]},
        "dimensionSchema": {"type": "array", "maxItems": 32, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"}}
      }
    }}
  }
}
