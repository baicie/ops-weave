{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Normalized browser read selection. URL encoding/bounds are specified in contracts/view-selection.md; no identity, credentials, cached data or commands.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "",
        "OPEN",
        "INVESTIGATING",
        "MITIGATED",
        "RESOLVED",
        "CLOSED"
      ]
    },
    "after": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$(?![\\s\\S])"
    },
    "incidentId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$(?![\\s\\S])"
    }
  },
  "required": [
    "status",
    "after",
    "incidentId"
  ]
}
