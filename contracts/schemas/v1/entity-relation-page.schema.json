{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authorized entity relation page",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "storage", "tenantId", "entityId", "asOf", "items", "nextCursor"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "storage": {"type": "string", "enum": ["memory", "postgres"]},
    "tenantId": {"type": "string", "minLength": 1, "maxLength": 128},
    "entityId": {"type": "string", "format": "uuid"},
    "asOf": {"type": "string", "format": "date-time"},
    "items": {"type": "array", "maxItems": 50, "items": {"$ref": "entity-relation.schema.json"}},
    "nextCursor": {"anyOf": [{"type": "string", "format": "uuid"}, {"type": "null"}]}
  }
}
