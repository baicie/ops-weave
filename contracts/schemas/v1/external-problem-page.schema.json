{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Bounded external problem page v1",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "storage": {
      "const": "not-persisted"
    },
    "dataMode": {
      "enum": [
        "labeled-fixture",
        "zabbix-jsonrpc"
      ]
    },
    "sourceInstanceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sourceContract": {
      "const": "zabbix-7.0-event-v1"
    },
    "query": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999999999
        },
        "till": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999999999
        },
        "afterEventId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "from",
        "till",
        "afterEventId",
        "limit"
      ]
    },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "external-problem.schema.json"
      }
    },
    "nextAfterEventId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "storage",
    "dataMode",
    "sourceInstanceId",
    "sourceContract",
    "query",
    "items",
    "nextAfterEventId"
  ]
}
