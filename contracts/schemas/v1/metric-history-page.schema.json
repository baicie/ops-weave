{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.invalid/schemas/v1/metric-history-page.schema.json",
  "title": "Bounded, non-persisted numeric source history page",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataMode", "persistence", "tenantId", "sourceInstanceId", "externalItemId", "entityId", "metricKey", "unit", "dimensions", "mappingRevision", "definitionVersion", "bindingVersion", "from", "till", "points", "nextCursor", "windowComplete"],
  "properties": {
    "dataMode": {"enum": ["labeled-fixture", "zabbix-jsonrpc"]},
    "persistence": {"const": "not-persisted"},
    "tenantId": {"type": "string", "minLength": 1},
    "sourceInstanceId": {"type": "string", "minLength": 1},
    "externalItemId": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"},
    "entityId": {"type": "string", "format": "uuid"},
    "metricKey": {"type": "string", "minLength": 1},
    "unit": {"type": "string", "minLength": 1},
    "dimensions": {"type": "object", "additionalProperties": {"type": "string"}},
    "mappingRevision": {"type": "integer", "minimum": 1},
    "definitionVersion": {"type": "integer", "minimum": 1},
    "bindingVersion": {"type": "integer", "minimum": 1},
    "from": {"$ref": "#/$defs/clock"},
    "till": {"$ref": "#/$defs/clock"},
    "points": {
      "type": "array", "maxItems": 500,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["clock", "ns", "value"],
        "properties": {
          "clock": {"$ref": "#/$defs/clock"},
          "ns": {"$ref": "#/$defs/ns"},
          "value": {"type": "string", "maxLength": 700, "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"}
        }
      }
    },
    "nextCursor": {
      "type": "object", "additionalProperties": false, "required": ["clock", "ns"],
      "properties": {"clock": {"$ref": "#/$defs/clock"}, "ns": {"$ref": "#/$defs/ns"}}
    },
    "windowComplete": {"type": "boolean"}
  },
  "$defs": {
    "clock": {"type": "integer", "minimum": 0, "maximum": 9999999999},
    "ns": {"type": "integer", "minimum": 0, "maximum": 999999999}
  }
}
