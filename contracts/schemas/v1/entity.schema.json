{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Entity v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "entityType": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "lifecycle": {
      "enum": [
        "DISCOVERED",
        "ACTIVE",
        "INACTIVE",
        "DELETED",
        "ARCHIVED"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "attributes": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "tenantId",
    "entityType",
    "name",
    "lifecycle",
    "version"
  ]
}
