{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "source-snapshot-config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "storage": {
      "const": "postgres"
    },
    "dataMode": {
      "const": "import"
    },
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
    },
    "sourceInstanceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}(?![\\s\\S])"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}(?![\\s\\S])"
    },
    "mappingDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "engine": {
      "const": "registered-cmdb-snapshot-v1"
    },
    "maxRecords": {
      "const": 100
    },
    "maxAgeSeconds": {
      "const": 604800
    }
  },
  "required": [
    "schemaVersion",
    "storage",
    "dataMode",
    "tenantId",
    "actor",
    "sourceInstanceId",
    "namespace",
    "mappingDigest",
    "engine",
    "maxRecords",
    "maxAgeSeconds"
  ]
}
