{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Incident v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "status": {
      "enum": [
        "OPEN",
        "INVESTIGATING",
        "MITIGATED",
        "RESOLVED",
        "CLOSED"
      ]
    },
    "severity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "tenantId",
    "title",
    "status",
    "severity",
    "version",
    "createdAt"
  ]
}
