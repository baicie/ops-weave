{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "history-service-grants",
  "description": "Operator-owned machine identity and history bounds. Semantic time ordering, at most 90 days validity/31 days data, issuer consistency and unique client/tenant-subject are enforced by the server.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "grants"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "grants": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issuer",
          "clientId",
          "externalSubject",
          "subjectId",
          "tenantId",
          "revision",
          "enabled",
          "sourceInstanceId",
          "itemIds",
          "entityIds",
          "metricKeys",
          "validFrom",
          "validUntil",
          "from",
          "till",
          "maxWindowSeconds",
          "maxPoints",
          "requestsPerMinute"
        ],
        "properties": {
          "issuer": {
            "$ref": "identity-grants.schema.json#/properties/grants/items/properties/issuer"
          },
          "clientId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,128}$(?![\\s\\S])"
          },
          "externalSubject": {
            "$ref": "identity-grants.schema.json#/properties/grants/items/properties/externalSubject"
          },
          "subjectId": {
            "$ref": "identity-grants.schema.json#/properties/grants/items/properties/subjectId"
          },
          "tenantId": {
            "$ref": "identity-grants.schema.json#/properties/grants/items/properties/tenantId"
          },
          "revision": {
            "$ref": "identity-grants.schema.json#/properties/grants/items/properties/revision"
          },
          "enabled": {
            "type": "boolean"
          },
          "sourceInstanceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$(?![\\s\\S])"
          },
          "itemIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$(?![\\s\\S])"
            }
          },
          "entityIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f-]{36}$(?![\\s\\S])"
            }
          },
          "metricKeys": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]{0,127}$(?![\\s\\S])"
            }
          },
          "validFrom": {
            "type": "string",
            "format": "date-time"
          },
          "validUntil": {
            "type": "string",
            "format": "date-time"
          },
          "from": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9999999999
          },
          "till": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9999999999
          },
          "maxWindowSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          },
          "maxPoints": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "requestsPerMinute": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          }
        }
      }
    }
  }
}
