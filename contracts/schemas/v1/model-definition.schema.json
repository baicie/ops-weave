{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v1/model-definition.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "kind",
    "label",
    "description",
    "cleaningProfile",
    "fields"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^(builtin|custom)\\.[a-z][a-z0-9_]{0,47}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "kind": {
      "enum": [
        "ENTITY",
        "RELATION"
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "cleaningProfile": {
      "const": "safe-scalars-v1"
    },
    "fields": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "type",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$",
            "not": {
              "enum": [
                "id",
                "tenant_id",
                "tenantId",
                "version",
                "source",
                "source_ref",
                "created_at",
                "updated_at",
                "__proto__",
                "constructor",
                "prototype"
              ]
            }
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "type": {
            "enum": [
              "TEXT",
              "INTEGER",
              "DECIMAL",
              "BOOLEAN",
              "ENUM",
              "DATETIME"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "maxLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2048
          },
          "min": {
            "type": "number",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "max": {
            "type": "number",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "choices": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "TEXT",
                    "ENUM"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "maxLength"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "maxLength"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "ENUM"
                }
              }
            },
            "then": {
              "required": [
                "choices"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "choices"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "INTEGER",
                    "DECIMAL"
                  ]
                }
              }
            },
            "then": {},
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "min"
                    ]
                  },
                  {
                    "required": [
                      "max"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "endpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "cardinality"
      ],
      "properties": {
        "from": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "revision"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^(builtin|custom)\\.[a-z][a-z0-9_]{0,47}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          }
        },
        "to": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "revision"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^(builtin|custom)\\.[a-z][a-z0-9_]{0,47}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          }
        },
        "cardinality": {
          "enum": [
            "ONE_TO_ONE",
            "ONE_TO_MANY",
            "MANY_TO_MANY"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "RELATION"
          }
        }
      },
      "then": {
        "required": [
          "endpoints"
        ],
        "properties": {
          "fields": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "endpoints"
          ]
        }
      }
    }
  ]
}
