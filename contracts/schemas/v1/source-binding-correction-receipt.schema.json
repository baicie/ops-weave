{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "source-binding-correction-receipt",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "storage": {
      "const": "postgres"
    },
    "dataMode": {
      "const": "import"
    },
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
    },
    "sourceInstanceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}(?![\\s\\S])"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}(?![\\s\\S])"
    },
    "command": {
      "$ref": "source-binding-correction-input.schema.json#/properties/command"
    },
    "previous": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "entityId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
        },
        "sourceInstanceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}(?![\\s\\S])"
        },
        "externalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "identity": {
          "$ref": "asset-identity-pin.schema.json"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z(?![\\s\\S])"
        },
        "ingestedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z(?![\\s\\S])"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z(?![\\s\\S])"
        },
        "present": {
          "type": "boolean"
        },
        "snapshotId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
        }
      },
      "required": [
        "tenantId",
        "entityId",
        "sourceInstanceId",
        "externalId",
        "identity",
        "observedAt",
        "ingestedAt",
        "expiresAt",
        "present",
        "snapshotId"
      ]
    },
    "snapshot": {
      "$ref": "source-snapshot-receipt.schema.json"
    },
    "previousEntityVersionAfter": {
      "type": "integer",
      "minimum": 2,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "storage",
    "dataMode",
    "tenantId",
    "actor",
    "sourceInstanceId",
    "namespace",
    "command",
    "previous",
    "snapshot",
    "previousEntityVersionAfter"
  ]
}
