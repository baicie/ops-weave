{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opsweave.invalid/v1/model-revision-review",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^(builtin|custom)\\.[a-z][a-z0-9_]{0,47}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "id",
            "revision",
            "digest"
          ]
        },
        "editVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "base": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^(builtin|custom)\\.[a-z][a-z0-9_]{0,47}$"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              },
              "required": [
                "id",
                "revision",
                "digest"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "compatible": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "enum": [
              "NON_CONSECUTIVE_REVISION",
              "INCOMPATIBLE_CHANGE",
              "UNKNOWN_ENTITY_TYPE"
            ]
          },
          "minItems": 0,
          "maxItems": 3,
          "uniqueItems": true
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fieldId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,47}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "property": {
                "enum": [
                  "LABEL",
                  "DESCRIPTION",
                  "KIND",
                  "REVISION",
                  "FIELD",
                  "TYPE",
                  "REQUIRED",
                  "MAX_LENGTH",
                  "MIN",
                  "MAX",
                  "CHOICES",
                  "FROM",
                  "TO",
                  "CARDINALITY"
                ]
              },
              "before": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 4096
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "after": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 4096
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "compatible": {
                "type": "boolean"
              }
            },
            "required": [
              "fieldId",
              "property",
              "before",
              "after",
              "compatible"
            ]
          },
          "minItems": 0,
          "maxItems": 300
        }
      },
      "required": [
        "candidate",
        "editVersion",
        "base",
        "reviewedAt",
        "compatible",
        "reasons",
        "changes"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "compatible": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "reasons": {
                "maxItems": 0
              },
              "changes": {
                "items": {
                  "properties": {
                    "compatible": {
                      "const": true
                    }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "reasons": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "review"
  ]
}
