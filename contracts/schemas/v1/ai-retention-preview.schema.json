{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "storage",
    "policy",
    "preview"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "storage": {
      "const": "postgres"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "version",
        "insightDays",
        "evidenceDays",
        "auditDays",
        "batchSize",
        "heldIncidents",
        "allowPurge"
      ],
      "properties": {
        "tenantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$(?![\\s\\S])"
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,64}$(?![\\s\\S])"
        },
        "insightDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "evidenceDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "auditDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "batchSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "heldIncidents": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$(?![\\s\\S])"
          },
          "maxItems": 1000,
          "uniqueItems": true
        },
        "allowPurge": {
          "type": "boolean"
        }
      }
    },
    "preview": {
      "$ref": "#/$defs/preview"
    }
  },
  "$defs": {
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "actor",
        "policyDigest",
        "asOf",
        "expiresAt",
        "previewDigest",
        "batches"
      ],
      "properties": {
        "tenantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$(?![\\s\\S])"
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$(?![\\s\\S])"
        },
        "policyDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
        },
        "asOf": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$(?![\\s\\S])"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$(?![\\s\\S])"
        },
        "previewDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
        },
        "batches": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "ids",
                "logicalBytes",
                "hasMore"
              ],
              "properties": {
                "kind": {
                  "const": "INSIGHT"
                },
                "ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$(?![\\s\\S])"
                  },
                  "maxItems": 100,
                  "uniqueItems": true
                },
                "logicalBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 14000000
                },
                "hasMore": {
                  "type": "boolean"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "ids",
                "logicalBytes",
                "hasMore"
              ],
              "properties": {
                "kind": {
                  "const": "EVIDENCE"
                },
                "ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$(?![\\s\\S])"
                  },
                  "maxItems": 100,
                  "uniqueItems": true
                },
                "logicalBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 14000000
                },
                "hasMore": {
                  "type": "boolean"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "ids",
                "logicalBytes",
                "hasMore"
              ],
              "properties": {
                "kind": {
                  "const": "AUDIT"
                },
                "ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$(?![\\s\\S])"
                  },
                  "maxItems": 100,
                  "uniqueItems": true
                },
                "logicalBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 14000000
                },
                "hasMore": {
                  "type": "boolean"
                }
              }
            }
          ],
          "items": false
        }
      }
    }
  }
}
