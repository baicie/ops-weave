{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opsweave.invalid/v1/model-revision-review-request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^custom\\.[a-z][a-z0-9_]{0,47}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "required": [
        "id",
        "revision"
      ]
    },
    "expectedEditVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "ref",
    "expectedEditVersion",
    "digest"
  ]
}
