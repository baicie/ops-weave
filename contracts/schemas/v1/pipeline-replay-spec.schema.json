{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "syncRunId": {
      "type": "string",
      "format": "uuid"
    },
    "targetVersion": {
      "$ref": "pipeline-ref.schema.json"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "purpose": {
      "enum": [
        "VALIDATE_MAPPING",
        "COMPARE_VERSION"
      ]
    }
  },
  "required": [
    "syncRunId",
    "targetVersion",
    "limit",
    "purpose"
  ]
}
