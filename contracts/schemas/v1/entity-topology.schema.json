{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Current authorized one-hop entity topology",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tenantId",
    "centerId",
    "asOf",
    "coverage",
    "limit",
    "truncated",
    "nodes",
    "edges"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "centerId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "coverage": {
      "const": "stored-current-one-hop"
    },
    "limit": {
      "const": 50
    },
    "truncated": {
      "type": "boolean"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 51,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "type",
          "lifecycle",
          "dataMode"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "lifecycle": {
            "enum": [
              "DISCOVERED",
              "ACTIVE",
              "INACTIVE",
              "DELETED",
              "ARCHIVED"
            ]
          },
          "dataMode": {
            "enum": [
              "fixture",
              "zabbix-jsonrpc",
              "import",
              "unknown"
            ]
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "type",
          "validFrom",
          "validTo",
          "dataMode"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
          },
          "from": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
          },
          "to": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "validFrom": {
            "type": "string",
            "format": "date-time"
          },
          "validTo": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "dataMode": {
            "enum": [
              "fixture",
              "zabbix-jsonrpc",
              "import",
              "unknown"
            ]
          }
        }
      }
    }
  }
}
