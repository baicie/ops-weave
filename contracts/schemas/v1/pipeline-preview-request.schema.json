{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "syncRunId": {
      "type": "string",
      "format": "uuid"
    },
    "definition": {
      "$ref": "pipeline-definition.schema.json"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 100
    }
  },
  "required": [
    "syncRunId",
    "definition"
  ]
}
