{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "storage": {
      "enum": [
        "memory",
        "postgres"
      ]
    },
    "items": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "pipeline-replay-header.schema.json"
      }
    },
    "nextCursor": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "storage",
    "items",
    "nextCursor"
  ]
}
