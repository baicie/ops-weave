{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "observation": {
      "$ref": "external-problem.schema.json"
    },
    "dataMode": {
      "enum": [
        "labeled-fixture",
        "zabbix-jsonrpc"
      ]
    },
    "sourceContract": {
      "const": "zabbix-7.0-event-v1"
    },
    "firstReceivedAt": {
      "type": "string",
      "format": "date-time"
    },
    "entities": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "hostId": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          },
          "entityId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "hostId",
          "entityId"
        ]
      }
    },
    "gaps": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "const": "ENTITY_MAPPING_MISSING"
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "observation",
    "dataMode",
    "sourceContract",
    "firstReceivedAt",
    "entities",
    "gaps"
  ]
}
