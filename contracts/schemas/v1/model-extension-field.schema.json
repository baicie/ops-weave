{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v1/model-extension-field.schema.json",
  "title": "Tenant model extension field",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "label",
    "type",
    "required"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,47}$",
      "not": {
        "enum": [
          "id",
          "tenant_id",
          "tenantId",
          "version",
          "source",
          "source_ref",
          "created_at",
          "updated_at",
          "__proto__",
          "constructor",
          "prototype"
        ]
      }
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "type": {
      "enum": [
        "TEXT",
        "INTEGER",
        "DECIMAL",
        "BOOLEAN",
        "ENUM",
        "DATETIME"
      ]
    },
    "required": {
      "const": false
    },
    "maxLength": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2048
    },
    "min": {
      "type": "number",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "max": {
      "type": "number",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "choices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "TEXT",
              "ENUM"
            ]
          }
        }
      },
      "then": {
        "required": [
          "maxLength"
        ]
      },
      "else": {
        "not": {
          "required": [
            "maxLength"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ENUM"
          }
        }
      },
      "then": {
        "required": [
          "choices"
        ]
      },
      "else": {
        "not": {
          "required": [
            "choices"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "INTEGER",
              "DECIMAL"
            ]
          }
        }
      },
      "then": {},
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "min"
              ]
            },
            {
              "required": [
                "max"
              ]
            }
          ]
        }
      }
    }
  ]
}
