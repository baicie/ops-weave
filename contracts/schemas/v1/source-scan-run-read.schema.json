{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "source-scan-run-read",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "storage": {
      "enum": ["postgres", "memory"]
    },
    "dataMode": {
      "const": "scan-log"
    },
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
    },
    "sourceInstanceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}(?![\\s\\S])"
    },
    "objectType": {
      "enum": ["host", "item"]
    },
    "run": {
      "$ref": "source-scan-run.schema.json"
    }
  },
  "required": [
    "schemaVersion",
    "storage",
    "dataMode",
    "tenantId",
    "sourceInstanceId",
    "objectType",
    "run"
  ]
}
