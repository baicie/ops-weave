{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "sessionId": {
      "type": "string",
      "format": "uuid"
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "builtAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "incident.diagnose"
        },
        "version": {
          "const": "2.0.0"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "mock-deterministic",
            "rig-openai"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "provider",
        "name"
      ]
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    },
    "insight": {
      "$ref": "insight-draft.schema.json"
    }
  },
  "required": [
    "runId",
    "sessionId",
    "question",
    "asOf",
    "builtAt",
    "completedAt",
    "skill",
    "model",
    "evidenceIds",
    "insight"
  ]
}
