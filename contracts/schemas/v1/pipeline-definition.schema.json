{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PipelineDefinition v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "zabbix"
        },
        "objectType": {
          "const": "host"
        }
      },
      "required": [
        "type",
        "objectType"
      ]
    },
    "nodes": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "type": {
            "enum": [
              "Source",
              "Parse",
              "Map",
              "Validate",
              "EntityResolve",
              "WriteObservation"
            ]
          },
          "config": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "displayNameField": {
                "enum": [
                  "name",
                  "host"
                ]
              }
            },
            "required": []
          }
        },
        "required": [
          "id",
          "type"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "not": {
                    "const": "Map"
                  }
                }
              }
            },
            "then": {
              "properties": {
                "config": {
                  "maxProperties": 0
                }
              }
            }
          }
        ]
      },
      "maxItems": 6
    },
    "edges": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "from",
          "to"
        ]
      },
      "maxItems": 5
    },
    "errorPolicy": {
      "enum": [
        "failFast",
        "skipRecord"
      ]
    }
  },
  "required": [
    "id",
    "revision",
    "source",
    "nodes",
    "edges",
    "errorPolicy"
  ]
}
