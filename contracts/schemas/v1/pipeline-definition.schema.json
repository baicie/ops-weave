{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PipelineDefinition v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "objectType": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["type", "objectType"]
    },
    "nodes": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": ["Source", "Parse", "Map", "Validate", "EntityResolve", "WriteObservation"]
          }
        },
        "required": ["id", "type"]
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 }
        },
        "required": ["from", "to"]
      }
    },
    "errorPolicy": {
      "enum": ["failFast", "skipRecord"]
    }
  },
  "required": ["id", "revision", "source", "nodes", "edges", "errorPolicy"]
}
