{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Server-owned complete LOG window data; no public write request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "workflowId",
    "revision",
    "digest",
    "from",
    "till",
    "inputCount",
    "filtered",
    "batchDigest",
    "records"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "workflowId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,47}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "from": {
      "type": "string",
      "format": "date-time"
    },
    "till": {
      "type": "string",
      "format": "date-time"
    },
    "inputCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "filtered": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "batchDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "records": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "workflow-log-window-record.schema.json"
      }
    }
  }
}
