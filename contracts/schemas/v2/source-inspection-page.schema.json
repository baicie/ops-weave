{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/source-inspection-page.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "storage",
    "sourceId",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "storage": {
      "enum": [
        "postgres",
        "memory"
      ]
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "items": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "source-inspection-view.schema.json"
      }
    }
  }
}
