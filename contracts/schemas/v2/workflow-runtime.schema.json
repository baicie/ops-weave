{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "mode": {
      "enum": [
        "LOCAL_DEV_ENTITY",
        "DELEGATED_ENTITY"
      ]
    },
    "pollSeconds": {
      "const": 5
    },
    "maxBatchRecords": {
      "const": 5
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "workflow-runtime-task.schema.json"
      },
      "maxItems": 20
    },
    "executions": {
      "type": "array",
      "items": {
        "$ref": "workflow-runtime-execution.schema.json"
      },
      "maxItems": 20
    },
    "backgroundAvailable": {
      "type": "boolean"
    }
  },
  "allOf": [{"if": {"properties": {"mode": {"const": "DELEGATED_ENTITY"}}, "required": ["mode"]}, "then": {"required": ["backgroundAvailable"]}}],
  "required": [
    "schemaVersion",
    "mode",
    "pollSeconds",
    "maxBatchRecords",
    "tasks",
    "executions"
  ]
}
