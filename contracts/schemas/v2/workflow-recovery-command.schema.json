{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://contracts.opsweave.invalid/v2/workflow-recovery-command",
  "properties": {
    "requestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,47}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "kind": {
      "enum": [
        "HOST_SCAN",
        "METRIC_STREAM",
        "LOG_STREAM"
      ]
    },
    "batchId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "expectedGeneration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "acknowledgeUncertainOutput": {
      "const": true
    }
  },
  "required": [
    "requestId",
    "id",
    "revision",
    "digest",
    "kind",
    "batchId",
    "expectedGeneration",
    "acknowledgeUncertainOutput"
  ]
}
