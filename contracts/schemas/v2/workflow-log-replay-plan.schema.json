{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opsweave.invalid/v2/workflow-log-replay-plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "reference",
    "commandDigest",
    "from",
    "till",
    "createdAt",
    "updatedAt",
    "expiresAt",
    "purpose",
    "outputPolicy",
    "notifications",
    "actions",
    "state",
    "proof",
    "error"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$(?![\\s\\S])"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$(?![\\s\\S])"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
        }
      }
    },
    "commandDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
    },
    "from": {
      "type": "string",
      "format": "date-time",
      "maxLength": 30,
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3}(?:\\d{3}(?:\\d{3})?)?)?Z$(?![\\s\\S])"
    },
    "till": {
      "type": "string",
      "format": "date-time",
      "maxLength": 30,
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3}(?:\\d{3}(?:\\d{3})?)?)?Z$(?![\\s\\S])"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 30,
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3}(?:\\d{3}(?:\\d{3})?)?)?Z$(?![\\s\\S])"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 30,
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3}(?:\\d{3}(?:\\d{3})?)?)?Z$(?![\\s\\S])"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 30,
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3}(?:\\d{3}(?:\\d{3})?)?)?Z$(?![\\s\\S])"
    },
    "purpose": {
      "const": "REBUILD_LOG_PROJECTION"
    },
    "outputPolicy": {
      "const": "ISOLATED_LOG_WINDOW"
    },
    "notifications": {
      "const": false
    },
    "actions": {
      "const": false
    },
    "state": {
      "enum": [
        "PREPARING",
        "READY",
        "FAILED"
      ]
    },
    "proof": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inputDigest",
            "batchDigest",
            "inputCount",
            "filtered",
            "scope",
            "indices",
            "positions"
          ],
          "properties": {
            "inputDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
            },
            "batchDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
            },
            "inputCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "filtered": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "scope": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tenant",
                "ownerScope",
                "requestId",
                "workflowId",
                "revision",
                "digest"
              ],
              "properties": {
                "tenant": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$(?![\\s\\S])"
                },
                "ownerScope": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
                },
                "requestId": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$(?![\\s\\S])"
                },
                "workflowId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,47}$(?![\\s\\S])"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
                }
              }
            },
            "indices": {
              "type": "array",
              "maxItems": 1000,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 999
              }
            },
            "positions": {
              "type": "array",
              "maxItems": 1000,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "date-time",
                "maxLength": 30,
                "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3}(?:\\d{3}(?:\\d{3})?)?)?Z$(?![\\s\\S])"
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "enum": [
        null,
        "FORBIDDEN",
        "SOURCE_UNAVAILABLE",
        "SOURCE_CHANGED",
        "MAPPING_CHANGED",
        "INVALID_SAMPLE",
        "WINDOW_INCOMPLETE",
        "SOURCE_WINDOW_CHANGED",
        "WINDOW_EXPIRED",
        "RUNTIME_UNAVAILABLE"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "READY"
          }
        }
      },
      "then": {
        "properties": {
          "proof": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "inputDigest",
              "batchDigest",
              "inputCount",
              "filtered",
              "scope",
              "indices",
              "positions"
            ],
            "properties": {
              "inputDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
              },
              "batchDigest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
              },
              "inputCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "filtered": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "scope": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tenant",
                  "ownerScope",
                  "requestId",
                  "workflowId",
                  "revision",
                  "digest"
                ],
                "properties": {
                  "tenant": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$(?![\\s\\S])"
                  },
                  "ownerScope": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
                  },
                  "requestId": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$(?![\\s\\S])"
                  },
                  "workflowId": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,47}$(?![\\s\\S])"
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
                  }
                }
              },
              "indices": {
                "type": "array",
                "maxItems": 1000,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 999
                }
              },
              "positions": {
                "type": "array",
                "maxItems": 1000,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "format": "date-time",
                  "maxLength": 30,
                  "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3}(?:\\d{3}(?:\\d{3})?)?)?Z$(?![\\s\\S])"
                }
              }
            }
          },
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "proof": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "FAILED"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "enum": [
              "FORBIDDEN",
              "SOURCE_UNAVAILABLE",
              "SOURCE_CHANGED",
              "MAPPING_CHANGED",
              "INVALID_SAMPLE",
              "WINDOW_INCOMPLETE",
              "SOURCE_WINDOW_CHANGED",
              "WINDOW_EXPIRED",
              "RUNTIME_UNAVAILABLE"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      }
    }
  ]
}
