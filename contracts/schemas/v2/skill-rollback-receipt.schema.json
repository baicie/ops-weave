{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/skill-rollback-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "skillId",
    "fromVersion",
    "toVersion",
    "reason",
    "rolledBackAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "requestId": {
      "$ref": "skill-common.schema.json#/$defs/uuid"
    },
    "skillId": {
      "$ref": "skill-common.schema.json#/$defs/skillId"
    },
    "fromVersion": {
      "$ref": "skill-common.schema.json#/$defs/version"
    },
    "toVersion": {
      "$ref": "skill-common.schema.json#/$defs/version"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "rolledBackAt": {
      "$ref": "skill-common.schema.json#/$defs/instant"
    }
  }
}
