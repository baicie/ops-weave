{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/registered-problem-page.schema.json",
  "title": "registered connection problem page",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "storage", "dataMode", "sourceId", "sourceInstanceId", "configurationRevision", "connectionDigest", "hostGroupIds", "scopeDigest", "query", "items", "nextAfterEventId"],
  "properties": {
    "schemaVersion": {"const": "2.0"},
    "storage": {"enum": ["postgres", "memory"]},
    "dataMode": {"const": "zabbix-jsonrpc"},
    "sourceId": {"type": "string", "format": "uuid"},
    "sourceInstanceId": {"type": "string", "minLength": 1, "maxLength": 128},
    "configurationRevision": {"type": "integer", "minimum": 1, "maximum": 100},
    "connectionDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "hostGroupIds": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "pattern": "^[1-9][0-9]{0,18}$"}},
    "scopeDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "query": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "till", "afterEventId", "limit"],
      "properties": {
        "from": {"type": "integer", "minimum": 0},
        "till": {"type": "integer", "minimum": 0},
        "afterEventId": {"type": ["string", "null"], "pattern": "^[1-9][0-9]{0,38}$"},
        "limit": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    },
    "items": {"type": "array", "maxItems": 100, "items": {"$ref": "registered-problem.schema.json"}},
    "nextAfterEventId": {"type": ["string", "null"], "pattern": "^[1-9][0-9]{0,38}$"}
  }
}
