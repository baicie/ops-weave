{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/workflow-output.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(builtin|custom)\\.[a-z][a-z0-9_]{0,47}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion"
      ],
      "properties": {
        "kind": {
          "enum": [
            "LOG",
            "METRIC"
          ]
        },
        "schemaVersion": {
          "const": "1.0"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "metricKey",
        "mappingPin"
      ],
      "properties": {
        "kind": {
          "const": "METRIC"
        },
        "schemaVersion": {
          "const": "1.1"
        },
        "metricKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:/-]{0,127}$"
        },
        "mappingPin": {
          "$ref": "metric-mapping-pin.schema.json"
        }
      }
    }
  ]
}
