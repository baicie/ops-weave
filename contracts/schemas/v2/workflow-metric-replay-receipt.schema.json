{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opsweave.invalid/v2/workflow-metric-replay-receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "planId",
    "reference",
    "commandDigest",
    "acceptedAt",
    "updatedAt",
    "state",
    "error"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$(?![\\s\\S])"
    },
    "planId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$(?![\\s\\S])"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$(?![\\s\\S])"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
        }
      }
    },
    "commandDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"
    },
    "acceptedAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 30,
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3}(?:\\d{3}(?:\\d{3})?)?)?Z$(?![\\s\\S])"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 30,
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3}(?:\\d{3}(?:\\d{3})?)?)?Z$(?![\\s\\S])"
    },
    "state": {
      "enum": [
        "PENDING",
        "UNKNOWN",
        "CONFIRMED",
        "FAILED"
      ]
    },
    "error": {
      "enum": [
        null,
        "FORBIDDEN",
        "SOURCE_UNAVAILABLE",
        "SOURCE_CHANGED",
        "MAPPING_CHANGED",
        "INVALID_SAMPLE",
        "WINDOW_INCOMPLETE",
        "SOURCE_WINDOW_CHANGED",
        "WINDOW_EXPIRED",
        "RUNTIME_UNAVAILABLE",
        "OUTPUT_REJECTED",
        "OUTPUT_UNCONFIRMED"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "UNKNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "const": "OUTPUT_UNCONFIRMED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "FAILED"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "enum": [
              "FORBIDDEN",
              "SOURCE_UNAVAILABLE",
              "SOURCE_CHANGED",
              "MAPPING_CHANGED",
              "INVALID_SAMPLE",
              "WINDOW_INCOMPLETE",
              "SOURCE_WINDOW_CHANGED",
              "WINDOW_EXPIRED",
              "RUNTIME_UNAVAILABLE",
              "OUTPUT_REJECTED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "PENDING",
              "CONFIRMED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      }
    }
  ]
}
