{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opsweave.invalid/v2/workflow-host-scan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "checkpoint",
    "batches"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "checkpoint": {
      "$ref": "workflow-host-checkpoint.schema.json"
    },
    "batches": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "workflow-host-batch.schema.json"
      }
    }
  }
}
