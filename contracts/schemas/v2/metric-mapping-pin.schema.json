{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "metric-mapping-pin",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "revision",
    "digest"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 71,
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
