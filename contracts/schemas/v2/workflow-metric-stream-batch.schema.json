{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opsweave.invalid/v2/workflow-metric-stream-batch",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "workflowId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,47}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "from": {
      "type": "string",
      "format": "date-time"
    },
    "till": {
      "type": "string",
      "format": "date-time"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "enum": [
        "IN_FLIGHT",
        "CONFIRMED",
        "UNKNOWN",
        "FAILED"
      ]
    },
    "inputCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 600
    },
    "filtered": {
      "type": "integer",
      "minimum": 0,
      "maximum": 600
    },
    "collapsed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 600
    },
    "labels": {
      "type": "object",
      "minProperties": 16,
      "maxProperties": 24,
      "propertyNames": {
        "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,63}$"
      },
      "required": [
        "tenant_id",
        "owner_scope",
        "source_instance_id",
        "external_item_id",
        "host_external_id",
        "metric_key",
        "unit",
        "mapping_id",
        "mapping_revision",
        "mapping_digest",
        "workflow_id",
        "workflow_revision",
        "workflow_digest",
        "configuration_digest",
        "data_mode",
        "collection_mode"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:/%\\\\-]{1,128}$"
        },
        "owner_scope": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_instance_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:/%\\\\-]{1,128}$"
        },
        "external_item_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:/%\\\\-]{1,128}$"
        },
        "host_external_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:/%\\\\-]{1,128}$"
        },
        "metric_key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:/%\\\\-]{1,128}$"
        },
        "unit": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:/%\\\\-]{1,128}$"
        },
        "mapping_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:/%\\\\-]{1,128}$"
        },
        "mapping_revision": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:/%\\\\-]{1,128}$"
        },
        "mapping_digest": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:/%\\\\-]{1,128}$"
        },
        "workflow_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:/%\\\\-]{1,128}$"
        },
        "workflow_revision": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:/%\\\\-]{1,128}$"
        },
        "workflow_digest": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:/%\\\\-]{1,128}$"
        },
        "configuration_digest": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:/%\\\\-]{1,128}$"
        },
        "data_mode": {
          "const": "zabbix-jsonrpc"
        },
        "collection_mode": {
          "const": "WINDOW_60S"
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^dim_[A-Za-z_][A-Za-z0-9_]{0,59}$": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:/%\\\\-]{1,128}$"
        }
      }
    },
    "batchDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamps": {
      "type": "array",
      "maxItems": 600,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "error": {
      "anyOf": [
        {
          "enum": [
            "OUTPUT_REJECTED",
            "OUTPUT_UNCONFIRMED"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "reconcilesBatchId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "latePoints": {
      "type": "integer",
      "minimum": 0,
      "maximum": 600
    }
  },
  "required": [
    "id",
    "workflowId",
    "revision",
    "digest",
    "from",
    "till",
    "createdAt",
    "updatedAt",
    "state",
    "inputCount",
    "filtered",
    "collapsed",
    "labels",
    "batchDigest",
    "timestamps",
    "error"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "UNKNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "const": "OUTPUT_UNCONFIRMED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "FAILED"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "const": "OUTPUT_REJECTED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "IN_FLIGHT",
              "CONFIRMED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "IN_FLIGHT",
              "UNKNOWN",
              "FAILED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "timestamps": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "reconcilesBatchId"
        ],
        "properties": {
          "reconcilesBatchId": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "latePoints": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "reconcilesBatchId"
        ],
        "properties": {
          "reconcilesBatchId": {
            "type": "string"
          }
        }
      },
      "then": {
        "properties": {
          "latePoints": {
            "minimum": 1
          },
          "timestamps": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "dependentRequired": {
    "reconcilesBatchId": [
      "latePoints"
    ],
    "latePoints": [
      "reconcilesBatchId"
    ]
  }
}
