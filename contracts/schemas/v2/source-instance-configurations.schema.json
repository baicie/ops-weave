{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/source-instance-configurations.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceId",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "revision",
          "connectionDigest",
          "dataMode",
          "createdAt"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "connectionDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "dataMode": {
            "enum": [
              "fixture",
              "zabbix-jsonrpc",
              "MANUAL_SAMPLE"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "maxLength": 40
          }
        }
      }
    }
  }
}
