{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/receipt-retention-preview-command.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "scopeKey",
    "maxRemove"
  ],
  "properties": {
    "kind": {
      "enum": [
        "onboarding",
        "source-command",
        "external-link"
      ]
    },
    "scopeKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:@-]{1,128}$"
    },
    "maxRemove": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  }
}
