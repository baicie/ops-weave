{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/workflow-log-source-pin.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "inspectionId",
    "itemId",
    "hostId",
    "sourceKey",
    "sourceUnit",
    "sourceValueType",
    "digest"
  ],
  "properties": {
    "inspectionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "itemId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "hostId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "sourceKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "sourceUnit": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
    },
    "sourceValueType": {
      "const": "LOG"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
