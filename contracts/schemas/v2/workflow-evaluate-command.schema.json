{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opsweave.invalid/v2/workflow-evaluate-command",
  "type": "object", "additionalProperties": false,
  "required": ["id", "revision", "editVersion", "digest", "dryRun"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,47}$"},
    "revision": {"type": "integer", "minimum": 1, "maximum": 10000},
    "editVersion": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "dryRun": {"const": true},
    "samples": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": {
        "type": "object", "maxProperties": 32,
        "propertyNames": {
          "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,47}$",
          "not": {"enum": ["tenantId", "tenant_id", "authorization", "Authorization", "constructor", "prototype", "secret", "token", "password"]}
        },
        "additionalProperties": {"type": ["string", "number", "boolean", "null"], "maxLength": 2048}
      }
    },
    "syncRunId": {"type": "string", "format": "uuid"}
  },
  "oneOf": [
    {"required": ["samples"], "not": {"required": ["syncRunId"]}},
    {"required": ["syncRunId"], "not": {"required": ["samples"]}}
  ]
}
