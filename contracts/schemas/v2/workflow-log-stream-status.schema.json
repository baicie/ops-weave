{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opsweave.invalid/v2/workflow-log-stream-status",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "available": {
      "type": "boolean"
    },
    "mode": {
      "enum": [
        "LOCAL_DEV_LOG",
        "DELEGATED_LOG"
      ]
    },
    "windowSeconds": {
      "const": 60
    },
    "settleSeconds": {
      "const": 10
    },
    "maxBatchRecords": {
      "const": 1000
    },
    "maxSessionBatches": {
      "const": 20
    },
    "task": {
      "anyOf": [
        {
          "$ref": "https://contracts.opsweave.invalid/v2/workflow-log-stream-task"
        },
        {
          "type": "null"
        }
      ]
    },
    "batches": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "https://contracts.opsweave.invalid/v2/workflow-log-stream-batch"
      }
    },
    "maxHistoryRequests": {
      "const": 20
    },
    "lookbackSeconds": {
      "const": 60
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "startAllowed",
        "recoveryClosed"
      ],
      "properties": {
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000001
        },
        "startAllowed": {
          "type": "boolean"
        },
        "recoveryClosed": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "startAllowed": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "generation": {
                "maximum": 999998
              },
              "recoveryClosed": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "resumeAllowed": {
      "type": "boolean"
    },
    "uncertainBatchIds": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
      }
    }
  },
  "required": [
    "schemaVersion",
    "available",
    "mode",
    "windowSeconds",
    "settleSeconds",
    "maxBatchRecords",
    "maxSessionBatches",
    "task",
    "batches",
    "maxHistoryRequests",
    "lookbackSeconds"
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "resumeAllowed"
        ],
        "properties": {
          "resumeAllowed": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "task": {
            "type": "object",
            "properties": {
              "state": {
                "enum": [
                  "STOPPED",
                  "FAILED"
                ]
              },
              "generation": {
                "maximum": 999998
              }
            }
          }
        }
      }
    }
  ]
}
