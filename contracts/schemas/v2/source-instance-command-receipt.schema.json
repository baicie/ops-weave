{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/source-instance-command-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receipt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "sourceId",
        "commandDigest",
        "instance"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
        },
        "sourceId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
        },
        "commandDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "instance": {
          "$ref": "source-instance.schema.json"
        }
      }
    }
  }
}
