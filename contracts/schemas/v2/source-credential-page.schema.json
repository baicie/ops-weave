{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/source-credential-page.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "storage",
    "items",
    "truncated",
    "vaultAvailable",
    "canConfigure",
    "secretWriteAvailable"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "storage": {
      "enum": [
        "memory",
        "postgres"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "source-credential.schema.json"
      },
      "maxItems": 20,
      "uniqueItems": true
    },
    "truncated": {
      "type": "boolean"
    },
    "vaultAvailable": {
      "type": "boolean"
    },
    "canConfigure": {
      "type": "boolean"
    },
    "secretWriteAvailable": {
      "type": "boolean"
    }
  }
}
