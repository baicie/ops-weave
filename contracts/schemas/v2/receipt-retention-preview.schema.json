{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/receipt-retention-preview.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "scopeKey",
    "previewDigest",
    "candidates",
    "removable",
    "keptProtected",
    "keptUnfinished",
    "maxRemove"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "kind": {
      "enum": [
        "onboarding",
        "source-command",
        "external-link"
      ]
    },
    "scopeKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:@-]{1,128}$"
    },
    "previewDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "candidates": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "removable": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "keptProtected": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5000
    },
    "keptUnfinished": {
      "const": 0
    },
    "maxRemove": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "removable": {
            "const": 0
          }
        },
        "required": [
          "removable"
        ]
      },
      "then": {
        "properties": {
          "candidates": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "removable": {
            "const": 100
          }
        },
        "required": [
          "removable"
        ]
      },
      "then": {
        "properties": {
          "candidates": {
            "minItems": 100
          }
        }
      }
    }
  ]
}
