{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "workflowId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,47}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "previewId": {
      "type": "string",
      "format": "uuid"
    },
    "commandDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "enum": [
        "PENDING",
        "CONFIRMED",
        "FAILED",
        "UNKNOWN"
      ]
    },
    "accepted": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "filtered": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "confirmed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "failed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "unknown": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "error": {
      "enum": [
        null,
        "OUTPUT_REJECTED",
        "FORBIDDEN",
        "RUNTIME_UNAVAILABLE",
        "OUTPUT_UNCONFIRMED"
      ]
    },
    "batchDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "indices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4
      }
    }
  },
  "required": [
    "requestId",
    "workflowId",
    "revision",
    "digest",
    "previewId",
    "commandDigest",
    "createdAt",
    "updatedAt",
    "state",
    "accepted",
    "filtered",
    "confirmed",
    "failed",
    "unknown",
    "error",
    "batchDigest",
    "indices"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "CONFIRMED"
          }
        }
      },
      "then": {
        "properties": {
          "confirmed": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "failed": {
            "const": 0
          },
          "unknown": {
            "const": 0
          },
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
