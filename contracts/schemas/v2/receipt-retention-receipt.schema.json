{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/receipt-retention-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "commandDigest",
    "createdAt",
    "kind",
    "scopeKey",
    "removed",
    "keptProtected",
    "keptUnfinished",
    "reason"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "commandDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "enum": [
        "onboarding",
        "source-command",
        "external-link"
      ]
    },
    "scopeKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:@-]{1,128}$"
    },
    "removed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "keptProtected": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5000
    },
    "keptUnfinished": {
      "const": 0
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    }
  }
}
