{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/skill-common.schema.json",
  "$defs": {
    "skillId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*){0,3}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "instant": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "enum": [
        "DRAFT",
        "IN_REVIEW",
        "PUBLISHED"
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvedAt"
      ],
      "properties": {
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
