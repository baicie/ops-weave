{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/source-endpoint.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "connectorKind",
    "address",
    "digest"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^(?!\\s)(?!.*[\\u0000-\\u001f\\u007f-\\u009f\\ufeff])[\\s\\S]*\\S$"
    },
    "connectorKind": {
      "const": "ZABBIX_HOST"
    },
    "address": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^https?://(?:[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+|\\[[0-9A-Fa-f:]+\\])(?::[1-9][0-9]{0,4})?/api_jsonrpc\\.php$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
