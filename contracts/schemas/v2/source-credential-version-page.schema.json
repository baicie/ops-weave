{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/source-credential-version-page.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "storage",
    "credentialId",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "storage": {
      "enum": [
        "memory",
        "postgres"
      ]
    },
    "credentialId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "source-credential-version.schema.json"
      },
      "maxItems": 100,
      "uniqueItems": true
    }
  }
}
