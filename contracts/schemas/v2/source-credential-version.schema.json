{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/source-credential-version.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pin",
    "createdAt",
    "revoked"
  ],
  "properties": {
    "pin": {
      "$ref": "source-credential-pin.schema.json"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    },
    "revoked": {
      "type": "boolean"
    }
  }
}
