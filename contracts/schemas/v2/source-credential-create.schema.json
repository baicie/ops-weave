{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/source-credential-create.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "name",
    "secret"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^(?!.*[\\x00-\\x1f\\x7f-\\x9f\\ufeff])\\S(?:.*\\S)?$"
    },
    "secret": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[!-~]+$"
    }
  }
}
