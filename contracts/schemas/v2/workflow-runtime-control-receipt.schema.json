{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "operation": {
      "enum": [
        "START",
        "STOP",
        "RESUME"
      ]
    },
    "commandDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "task": {
      "$ref": "workflow-runtime-task.schema.json"
    }
  },
  "required": [
    "requestId",
    "operation",
    "commandDigest",
    "createdAt",
    "task"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "START",
              "RESUME"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "task": {
            "properties": {
              "state": {
                "const": "RUNNING"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "task": {
            "properties": {
              "state": {
                "const": "STOPPED"
              }
            }
          }
        }
      }
    }
  ]
}
