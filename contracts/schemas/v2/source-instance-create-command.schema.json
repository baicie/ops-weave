{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/source-instance-create-command.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "name",
    "description",
    "source",
    "connectionDigest"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "instanceId"
      ],
      "properties": {
        "kind": {
          "enum": [
            "ZABBIX_HOST",
            "MANUAL_SAMPLE"
          ]
        },
        "instanceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "MANUAL_SAMPLE"
              }
            }
          },
          "then": {
            "properties": {
              "instanceId": {
                "const": "manual"
              }
            }
          }
        }
      ]
    },
    "connectionDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
