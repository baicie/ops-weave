{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/workflow-definition.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "name",
    "source",
    "target",
    "nodes",
    "edges"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,47}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "instanceId"
      ],
      "properties": {
        "kind": {
          "enum": [
            "MANUAL_SAMPLE",
            "ZABBIX_HOST"
          ]
        },
        "instanceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "MANUAL_SAMPLE"
              }
            }
          },
          "then": {
            "properties": {
              "instanceId": {
                "const": "manual"
              }
            }
          }
        }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(builtin|custom)\\.[a-z][a-z0-9_]{0,47}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 16,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "version",
              "config"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,31}$"
              },
              "type": {
                "const": "SOURCE"
              },
              "version": {
                "const": "1"
              },
              "config": {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {}
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "version",
              "config"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,31}$"
              },
              "type": {
                "const": "MAP"
              },
              "version": {
                "const": "1"
              },
              "config": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 32,
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,47}$",
                  "not": {
                    "enum": [
                      "tenantId",
                      "tenant_id",
                      "Authorization",
                      "authorization",
                      "constructor",
                      "prototype",
                      "secret",
                      "token",
                      "password"
                    ]
                  }
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,47}$",
                  "not": {
                    "enum": [
                      "tenantId",
                      "tenant_id",
                      "Authorization",
                      "authorization",
                      "constructor",
                      "prototype",
                      "secret",
                      "token",
                      "password"
                    ]
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "version",
              "config"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,31}$"
              },
              "type": {
                "const": "TRIM"
              },
              "version": {
                "const": "1"
              },
              "config": {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {}
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "version",
              "config"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,31}$"
              },
              "type": {
                "const": "EMPTY_TO_NULL"
              },
              "version": {
                "const": "1"
              },
              "config": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field"
                ],
                "properties": {
                  "field": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,47}$",
                    "not": {
                      "enum": [
                        "tenantId",
                        "tenant_id",
                        "Authorization",
                        "authorization",
                        "constructor",
                        "prototype",
                        "secret",
                        "token",
                        "password"
                      ]
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "version",
              "config"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,31}$"
              },
              "type": {
                "const": "DEFAULT"
              },
              "version": {
                "const": "1"
              },
              "config": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field",
                  "value"
                ],
                "properties": {
                  "field": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,47}$",
                    "not": {
                      "enum": [
                        "tenantId",
                        "tenant_id",
                        "Authorization",
                        "authorization",
                        "constructor",
                        "prototype",
                        "secret",
                        "token",
                        "password"
                      ]
                    }
                  },
                  "value": {
                    "type": "string",
                    "maxLength": 512
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "version",
              "config"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,31}$"
              },
              "type": {
                "const": "ENUM_MAP"
              },
              "version": {
                "const": "1"
              },
              "config": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field",
                  "from",
                  "to"
                ],
                "properties": {
                  "field": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,47}$",
                    "not": {
                      "enum": [
                        "tenantId",
                        "tenant_id",
                        "Authorization",
                        "authorization",
                        "constructor",
                        "prototype",
                        "secret",
                        "token",
                        "password"
                      ]
                    }
                  },
                  "from": {
                    "type": "string",
                    "maxLength": 512
                  },
                  "to": {
                    "type": "string",
                    "maxLength": 512
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "version",
              "config"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,31}$"
              },
              "type": {
                "const": "SCALE"
              },
              "version": {
                "const": "1"
              },
              "config": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field",
                  "factor"
                ],
                "properties": {
                  "field": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,47}$",
                    "not": {
                      "enum": [
                        "tenantId",
                        "tenant_id",
                        "Authorization",
                        "authorization",
                        "constructor",
                        "prototype",
                        "secret",
                        "token",
                        "password"
                      ]
                    }
                  },
                  "factor": {
                    "type": "string",
                    "maxLength": 64,
                    "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "version",
              "config"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,31}$"
              },
              "type": {
                "const": "FILTER"
              },
              "version": {
                "const": "1"
              },
              "config": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field",
                  "equals"
                ],
                "properties": {
                  "field": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,47}$",
                    "not": {
                      "enum": [
                        "tenantId",
                        "tenant_id",
                        "Authorization",
                        "authorization",
                        "constructor",
                        "prototype",
                        "secret",
                        "token",
                        "password"
                      ]
                    }
                  },
                  "equals": {
                    "type": "string",
                    "maxLength": 512
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "version",
              "config"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,31}$"
              },
              "type": {
                "const": "VALIDATE"
              },
              "version": {
                "const": "1"
              },
              "config": {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {}
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "version",
              "config"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,31}$"
              },
              "type": {
                "const": "OUTPUT"
              },
              "version": {
                "const": "1"
              },
              "config": {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {}
              }
            }
          }
        ]
      }
    },
    "edges": {
      "type": "array",
      "minItems": 3,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          }
        }
      }
    }
  }
}
