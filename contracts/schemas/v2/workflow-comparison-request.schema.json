{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://opsweave.dev/schemas/v2/workflow-comparison-request.schema.json",
  "type":"object","additionalProperties":false,"required":["base","candidate"],
  "properties":{"base":{"$ref":"#/$defs/reference"},"candidate":{"$ref":"#/$defs/reference"}},
  "$defs":{"reference":{
    "type":"object","additionalProperties":false,"required":["id","revision","state","editVersion","digest"],
    "properties":{"id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,47}$"},"revision":{"type":"integer","minimum":1,"maximum":10000},"state":{"enum":["DRAFT","PUBLISHED"]},"editVersion":{"type":"integer","minimum":0,"maximum":1000000},"digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}},
    "allOf":[{"if":{"properties":{"state":{"const":"PUBLISHED"}}},"then":{"properties":{"editVersion":{"const":0}}},"else":{"properties":{"editVersion":{"minimum":1}}}}]
  }}
}
