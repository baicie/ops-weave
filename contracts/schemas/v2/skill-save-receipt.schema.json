{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/skill-save-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "draftId",
    "skillId",
    "version",
    "state",
    "editVersion",
    "contentDigest",
    "savedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "requestId": {
      "$ref": "skill-common.schema.json#/$defs/uuid"
    },
    "draftId": {
      "$ref": "skill-common.schema.json#/$defs/uuid"
    },
    "skillId": {
      "$ref": "skill-common.schema.json#/$defs/skillId"
    },
    "version": {
      "$ref": "skill-common.schema.json#/$defs/version"
    },
    "state": {
      "const": "DRAFT"
    },
    "editVersion": {
      "type": "integer",
      "minimum": 1
    },
    "contentDigest": {
      "$ref": "skill-common.schema.json#/$defs/digest"
    },
    "savedAt": {
      "$ref": "skill-common.schema.json#/$defs/instant"
    }
  }
}
