{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "queriedAt": {
      "type": "string",
      "format": "date-time"
    },
    "dataMode": {
      "const": "time-series"
    },
    "expectedPoints": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "proofMatches": {
      "type": "boolean"
    },
    "points": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "timestampMillis": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "value": {
            "type": "string",
            "maxLength": 400,
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          }
        },
        "required": [
          "timestampMillis",
          "value"
        ]
      }
    }
  },
  "required": [
    "requestId",
    "queriedAt",
    "dataMode",
    "expectedPoints",
    "proofMatches",
    "points"
  ]
}
