{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opsweave.invalid/v2/workflow-history-cursor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotAt",
    "watermark",
    "recordedCount",
    "seen",
    "lastId"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "snapshotAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 30,
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3}(?:\\d{3}(?:\\d{3})?)?)?Z$"
    },
    "watermark": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "recordedCount": {
      "type": "integer",
      "minimum": 21,
      "maximum": 200
    },
    "seen": {
      "type": "integer",
      "minimum": 20,
      "maximum": 180,
      "multipleOf": 20
    },
    "lastId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    }
  }
}
