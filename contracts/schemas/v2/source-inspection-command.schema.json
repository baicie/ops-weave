{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/source-inspection-command.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "configurationRevision",
    "connectionDigest"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "configurationRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "connectionDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
