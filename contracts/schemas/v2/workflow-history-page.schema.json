{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opsweave.invalid/v2/workflow-history-page",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "asOf",
    "snapshotAt",
    "reference",
    "coverage",
    "offset",
    "recordedCount",
    "items",
    "nextCursor",
    "hasMore"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "asOf": {
      "type": "string",
      "format": "date-time",
      "maxLength": 30,
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3}(?:\\d{3}(?:\\d{3})?)?)?Z$"
    },
    "snapshotAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 30,
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3}(?:\\d{3}(?:\\d{3})?)?)?Z$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "revision",
        "digest"
      ]
    },
    "coverage": {
      "const": "RECORDED_CHECKS"
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 180,
      "multipleOf": 20
    },
    "recordedCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 200
    },
    "items": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "$ref": "workflow-diagnostic-observation.schema.json"
      }
    },
    "nextCursor": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 4,
          "maxLength": 1024,
          "pattern": "^h1\\.[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "hasMore": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "hasMore": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "nextCursor": {
            "type": "string",
            "minLength": 4,
            "maxLength": 1024,
            "pattern": "^h1\\.[A-Za-z0-9_-]+$"
          },
          "items": {
            "minItems": 20,
            "maxItems": 20
          }
        }
      },
      "else": {
        "properties": {
          "nextCursor": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recordedCount": {
            "const": 0
          }
        }
      },
      "then": {
        "properties": {
          "offset": {
            "const": 0
          },
          "items": {
            "maxItems": 0
          },
          "hasMore": {
            "const": false
          }
        }
      },
      "else": {
        "properties": {
          "items": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
