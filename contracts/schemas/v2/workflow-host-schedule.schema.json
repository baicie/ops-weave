{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opsweave.invalid/v2/workflow-host-schedule",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "workflowId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,47}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identityField": {
          "const": "entity_id"
        },
        "nameField": {
          "allOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,47}$"
            },
            {
              "not": {
                "enum": [
                  "tenantId",
                  "tenant_id",
                  "authorization",
                  "Authorization",
                  "constructor",
                  "prototype",
                  "secret",
                  "token",
                  "password"
                ]
              }
            }
          ]
        }
      },
      "required": [
        "identityField",
        "nameField"
      ]
    },
    "intervalSeconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 900
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000001
    },
    "state": {
      "enum": [
        "RUNNING",
        "STOPPED",
        "FAILED"
      ]
    },
    "taskGeneration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000001
    },
    "activeScanId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "accountedScanId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "completedScans": {
      "type": "integer",
      "minimum": 0,
      "maximum": 200
    },
    "confirmedRecords": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "sessionBatches": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "nextRunAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "lastSuccessAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "error": {
      "anyOf": [
        {
          "enum": [
            "INVALID_SAMPLE",
            "SOURCE_UNAVAILABLE",
            "FORBIDDEN",
            "MODEL_CHANGED",
            "OPERATOR_CHANGED",
            "OUTPUT_UNAVAILABLE",
            "BACKLOG_LIMIT",
            "RUNTIME_UNAVAILABLE",
            "AUTHORIZATION_EXPIRED",
            "AUTHORIZATION_REVOKED",
            "EXECUTION_LIMIT",
            "TASK_CHANGED"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "workflowId",
    "revision",
    "digest",
    "settings",
    "intervalSeconds",
    "generation",
    "state",
    "taskGeneration",
    "activeScanId",
    "accountedScanId",
    "completedScans",
    "confirmedRecords",
    "sessionBatches",
    "nextRunAt",
    "lastSuccessAt",
    "updatedAt",
    "error"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "FAILED"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "enum": [
              "INVALID_SAMPLE",
              "SOURCE_UNAVAILABLE",
              "FORBIDDEN",
              "MODEL_CHANGED",
              "OPERATOR_CHANGED",
              "OUTPUT_UNAVAILABLE",
              "BACKLOG_LIMIT",
              "RUNTIME_UNAVAILABLE",
              "AUTHORIZATION_EXPIRED",
              "AUTHORIZATION_REVOKED",
              "EXECUTION_LIMIT",
              "TASK_CHANGED"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "STOPPED",
              "FAILED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "nextRunAt": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "activeScanId": {
            "type": "string"
          }
        }
      },
      "then": {
        "properties": {
          "nextRunAt": {
            "type": "null"
          }
        }
      }
    }
  ]
}
