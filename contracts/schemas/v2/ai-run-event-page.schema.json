{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/ai-run-event-page.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "items",
    "nextCursor",
    "hasMore",
    "gap",
    "snapshot"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "items": {
      "type": "array",
      "minItems": 0,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "$ref": "ai-run-event.schema.json"
      }
    },
    "nextCursor": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "maxLength": 18,
          "pattern": "^[1-9][0-9]{0,17}$"
        }
      ]
    },
    "hasMore": {
      "type": "boolean"
    },
    "gap": {
      "type": "boolean"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "statusVersion",
        "attempt",
        "updatedAt"
      ],
      "properties": {
        "status": {
          "enum": [
            "PENDING",
            "RUNNING",
            "WAITING_TOOL",
            "SUCCEEDED",
            "FAILED",
            "CANCELLED"
          ]
        },
        "statusVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "attempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "hasMore": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "nextCursor": {
            "type": "string"
          },
          "items": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "hasMore": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "nextCursor": {
            "type": "null"
          }
        }
      }
    }
  ]
}
