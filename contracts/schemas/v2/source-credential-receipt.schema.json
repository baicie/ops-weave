{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/source-credential-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "credentialId",
    "operation",
    "commandDigest",
    "credential"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "credentialId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "operation": {
      "enum": [
        "CREATE",
        "EDIT",
        "REVOKE_VERSION"
      ]
    },
    "commandDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "credential": {
      "$ref": "source-credential.schema.json"
    }
  }
}
