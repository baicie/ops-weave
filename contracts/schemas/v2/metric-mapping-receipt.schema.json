{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "metric-mapping-receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "expectedBindingVersion",
    "commandDigest",
    "previousPin",
    "binding",
    "createdAt"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "expectedBindingVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999999999
    },
    "commandDigest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 71,
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "previousPin": {
      "oneOf": [
        {
          "$ref": "metric-mapping-pin.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "binding": {
      "$ref": "metric-mapping-binding.schema.json"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
