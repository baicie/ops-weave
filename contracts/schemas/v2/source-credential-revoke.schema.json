{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/source-credential-revoke.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "expectedEditVersion"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "expectedEditVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    }
  }
}
