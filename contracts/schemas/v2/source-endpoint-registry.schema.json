{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/source-endpoint-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "endpoints"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "endpoints": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "connectorKind",
          "address",
          "tenants"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^(?!\\s)(?!.*[\\u0000-\\u001f\\u007f-\\u009f\\ufeff])[\\s\\S]*\\S$"
          },
          "connectorKind": {
            "const": "ZABBIX_HOST"
          },
          "address": {
            "type": "string",
            "maxLength": 1024,
            "pattern": "^https?://(?:[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+|\\[[0-9A-Fa-f:]+\\])(?::[1-9][0-9]{0,4})?/api_jsonrpc\\.php$"
          },
          "tenants": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            }
          }
        }
      }
    }
  }
}
