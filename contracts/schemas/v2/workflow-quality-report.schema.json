{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opsweave.invalid/v2/workflow-quality-report",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "asOf": {
      "type": "string",
      "format": "date-time",
      "maxLength": 30
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "revision",
        "digest"
      ]
    },
    "kind": {
      "enum": [
        "HOST_SCAN",
        "METRIC_STREAM",
        "LOG_STREAM"
      ]
    },
    "task": {
      "anyOf": [
        {
          "$ref": "https://contracts.opsweave.invalid/v2/workflow-quality-task"
        },
        {
          "type": "null"
        }
      ]
    },
    "batches": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "https://contracts.opsweave.invalid/v2/workflow-quality-batch"
      }
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "asOf",
    "reference",
    "kind",
    "task",
    "batches",
    "truncated"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "truncated": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "batches": {
            "minItems": 20
          }
        }
      }
    }
  ]
}
