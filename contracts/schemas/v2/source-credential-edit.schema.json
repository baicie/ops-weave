{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/source-credential-edit.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "expectedEditVersion",
    "name",
    "state",
    "secret"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "expectedEditVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^(?!.*[\\x00-\\x1f\\x7f-\\x9f\\ufeff])\\S(?:.*\\S)?$"
    },
    "state": {
      "enum": [
        "ACTIVE",
        "REVOKED"
      ]
    },
    "secret": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[!-~]+$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "REVOKED"
          }
        }
      },
      "then": {
        "properties": {
          "secret": {
            "type": "null"
          }
        }
      }
    }
  ]
}
