{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,47}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identityField": {
          "allOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,47}$"
            },
            {
              "not": {
                "enum": [
                  "tenantId",
                  "tenant_id",
                  "authorization",
                  "Authorization",
                  "constructor",
                  "prototype",
                  "secret",
                  "token",
                  "password"
                ]
              }
            }
          ]
        },
        "nameField": {
          "allOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,47}$"
            },
            {
              "not": {
                "enum": [
                  "tenantId",
                  "tenant_id",
                  "authorization",
                  "Authorization",
                  "constructor",
                  "prototype",
                  "secret",
                  "token",
                  "password"
                ]
              }
            }
          ]
        }
      },
      "required": [
        "identityField",
        "nameField"
      ]
    },
    "previewId": {
      "type": "string",
      "format": "uuid"
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "maxProperties": 32,
        "propertyNames": {
          "allOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,47}$"
            },
            {
              "not": {
                "enum": [
                  "tenantId",
                  "tenant_id",
                  "authorization",
                  "Authorization",
                  "constructor",
                  "prototype",
                  "secret",
                  "token",
                  "password"
                ]
              }
            }
          ]
        },
        "additionalProperties": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            },
            {
              "type": "number",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "maxLength": 2048
            }
          ]
        }
      }
    },
    "syncRunId": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "id",
    "revision",
    "digest",
    "settings",
    "previewId"
  ],
  "oneOf": [
    {
      "required": [
        "samples"
      ],
      "not": {
        "required": [
          "syncRunId"
        ]
      }
    },
    {
      "required": [
        "syncRunId"
      ],
      "not": {
        "required": [
          "samples"
        ]
      }
    }
  ]
}
