{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "maxBatches": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "consumedBatches": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "issuer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!.*[\\u0000-\\u001f\\u007f-\\u009f]).*\\S.*$"
    },
    "externalSubject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?!.*[\\u0000-\\u001f\\u007f-\\u009f]).*\\S.*$"
    },
    "grantDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "id",
    "issuedAt",
    "expiresAt",
    "maxBatches",
    "consumedBatches",
    "issuer",
    "externalSubject",
    "grantDigest"
  ]
}
