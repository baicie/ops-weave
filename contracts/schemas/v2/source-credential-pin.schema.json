{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/source-credential-pin.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "credentialId",
    "revision",
    "versionId"
  ],
  "properties": {
    "credentialId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "versionId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    }
  }
}
