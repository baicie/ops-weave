{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "workflowId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,47}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "previewId": {
      "type": "string",
      "format": "uuid"
    },
    "commandDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "enum": [
        "PENDING",
        "CONFIRMED",
        "UNKNOWN",
        "FAILED"
      ]
    },
    "accepted": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "filtered": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "collapsed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "confirmed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "failed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "unknown": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "error": {
      "enum": [
        null,
        "OUTPUT_REJECTED",
        "OUTPUT_UNCONFIRMED",
        "FORBIDDEN",
        "SOURCE_CHANGED",
        "MAPPING_CHANGED",
        "RUNTIME_UNAVAILABLE"
      ]
    },
    "labels": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:/%\\-]{1,128}$"
        },
        "owner_scope": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_instance_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:/%\\-]{1,128}$"
        },
        "external_item_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:/%\\-]{1,128}$"
        },
        "host_external_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:/%\\-]{1,128}$"
        },
        "metric_key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:/%\\-]{1,128}$"
        },
        "unit": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:/%\\-]{1,128}$"
        },
        "mapping_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:/%\\-]{1,128}$"
        },
        "mapping_revision": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:/%\\-]{1,128}$"
        },
        "mapping_digest": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:/%\\-]{1,128}$"
        },
        "workflow_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:/%\\-]{1,128}$"
        },
        "workflow_revision": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:/%\\-]{1,128}$"
        },
        "workflow_digest": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:/%\\-]{1,128}$"
        },
        "configuration_digest": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:/%\\-]{1,128}$"
        },
        "data_mode": {
          "const": "zabbix-jsonrpc"
        }
      },
      "required": [
        "tenant_id",
        "owner_scope",
        "source_instance_id",
        "external_item_id",
        "host_external_id",
        "metric_key",
        "unit",
        "mapping_id",
        "mapping_revision",
        "mapping_digest",
        "workflow_id",
        "workflow_revision",
        "workflow_digest",
        "configuration_digest",
        "data_mode"
      ],
      "patternProperties": {
        "^dim_[A-Za-z_][A-Za-z0-9_]{0,59}$": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:/%\\-]{1,128}$"
        }
      },
      "maxProperties": 24
    },
    "seriesHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "batchDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    }
  },
  "required": [
    "requestId",
    "workflowId",
    "revision",
    "digest",
    "previewId",
    "commandDigest",
    "createdAt",
    "updatedAt",
    "state",
    "accepted",
    "filtered",
    "collapsed",
    "confirmed",
    "failed",
    "unknown",
    "error",
    "labels",
    "seriesHash",
    "batchDigest",
    "timestamps"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "CONFIRMED"
          }
        }
      },
      "then": {
        "properties": {
          "confirmed": {
            "minimum": 1
          },
          "failed": {
            "const": 0
          },
          "unknown": {
            "const": 0
          },
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "FAILED"
          }
        }
      },
      "then": {
        "properties": {
          "confirmed": {
            "const": 0
          },
          "failed": {
            "minimum": 1
          },
          "unknown": {
            "const": 0
          },
          "error": {
            "enum": [
              "OUTPUT_REJECTED",
              "FORBIDDEN",
              "SOURCE_CHANGED",
              "MAPPING_CHANGED",
              "RUNTIME_UNAVAILABLE"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "PENDING",
              "UNKNOWN"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "confirmed": {
            "const": 0
          },
          "failed": {
            "const": 0
          },
          "unknown": {
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "PENDING"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "UNKNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "const": "OUTPUT_UNCONFIRMED"
          }
        }
      }
    }
  ]
}
