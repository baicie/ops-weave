{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/workflow-run-detail.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "run",
    "trace"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflowId",
        "revision",
        "mode",
        "receipt"
      ],
      "properties": {
        "workflowId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "mode": {
          "enum": [
            "PREVIEW",
            "RUN"
          ]
        },
        "receipt": {
          "$ref": "workflow-receipt.schema.json"
        }
      }
    },
    "trace": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "target",
            "syncRunId",
            "startedAt",
            "durationMillis",
            "retainedCount",
            "missingRaw",
            "truncated",
            "sourceStatus",
            "dryRun",
            "writesPerformed",
            "rows"
          ],
          "properties": {
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "instanceId"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "MANUAL_SAMPLE",
                    "ZABBIX_HOST"
                  ]
                },
                "instanceId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "MANUAL_SAMPLE"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "instanceId": {
                        "const": "manual"
                      }
                    }
                  }
                }
              ]
            },
            "target": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "revision",
                "digest"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^(builtin|custom)\\.[a-z][a-z0-9_]{0,47}$"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              }
            },
            "syncRunId": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "startedAt": {
              "type": "string",
              "format": "date-time"
            },
            "durationMillis": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "retainedCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "missingRaw": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "truncated": {
              "type": "boolean"
            },
            "sourceStatus": {
              "enum": [
                "MANUAL_SAMPLE",
                "SUCCEEDED",
                "FAILED"
              ]
            },
            "dryRun": {
              "const": true
            },
            "writesPerformed": {
              "const": false
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "index",
                  "status",
                  "steps"
                ],
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4
                  },
                  "status": {
                    "enum": [
                      "ACCEPTED",
                      "REJECTED",
                      "FILTERED"
                    ]
                  },
                  "steps": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 16,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "nodeId",
                        "type",
                        "status",
                        "issues"
                      ],
                      "properties": {
                        "nodeId": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                        },
                        "type": {
                          "enum": [
                            "SOURCE",
                            "MAP",
                            "TRIM",
                            "EMPTY_TO_NULL",
                            "DEFAULT",
                            "ENUM_MAP",
                            "SCALE",
                            "FILTER",
                            "VALIDATE",
                            "OUTPUT"
                          ]
                        },
                        "status": {
                          "enum": [
                            "OK",
                            "ERROR",
                            "FILTERED",
                            "SKIPPED"
                          ]
                        },
                        "issues": {
                          "type": "array",
                          "maxItems": 64,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "field",
                              "code"
                            ],
                            "properties": {
                              "field": {
                                "type": "string",
                                "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,47}$"
                              },
                              "code": {
                                "enum": [
                                  "UNKNOWN_FIELD",
                                  "MISSING_REQUIRED",
                                  "NULL_REQUIRED",
                                  "TOO_LONG",
                                  "EMPTY_REQUIRED",
                                  "ENUM_MISMATCH",
                                  "OUT_OF_RANGE",
                                  "TYPE_MISMATCH",
                                  "NUMERIC_LIMIT",
                                  "TRANSFORM_FAILED"
                                ]
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
