{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/ai-run-retry-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "runId",
    "requestedAt",
    "attempt",
    "status",
    "reconciliation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "status": {
      "enum": [
        "PENDING",
        "RUNNING",
        "WAITING_TOOL",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "reconciliation": {
      "$ref": "ai-run-reconciliation.schema.json"
    }
  }
}
