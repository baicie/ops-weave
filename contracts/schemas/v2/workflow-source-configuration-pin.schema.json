{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/workflow-source-configuration-pin.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceId",
    "revision",
    "digest"
  ],
  "properties": {
    "sourceId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
