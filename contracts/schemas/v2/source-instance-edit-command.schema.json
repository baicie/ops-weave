{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/source-instance-edit-command.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "expectedEditVersion",
    "name",
    "description",
    "connectionDigest",
    "state"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "expectedEditVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "connectionDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "state": {
      "enum": [
        "ACTIVE",
        "ARCHIVED"
      ]
    }
  }
}
