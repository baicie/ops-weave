{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opsweave.invalid/v2/workflow-host-schedule-command",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,47}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identityField": {
          "const": "entity_id"
        },
        "nameField": {
          "allOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,47}$"
            },
            {
              "not": {
                "enum": [
                  "tenantId",
                  "tenant_id",
                  "authorization",
                  "Authorization",
                  "constructor",
                  "prototype",
                  "secret",
                  "token",
                  "password"
                ]
              }
            }
          ]
        }
      },
      "required": [
        "identityField",
        "nameField"
      ]
    },
    "intervalSeconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 900
    },
    "expectedGeneration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    }
  },
  "required": [
    "requestId",
    "id",
    "revision",
    "digest",
    "settings",
    "intervalSeconds",
    "expectedGeneration"
  ]
}
