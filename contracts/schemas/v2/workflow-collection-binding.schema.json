{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/workflow-collection-binding.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "revision",
    "digest",
    "sourceInstanceId",
    "state",
    "generation",
    "updatedAt",
    "reason"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,47}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "sourceInstanceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "state": {
      "enum": [
        "BOUND",
        "UNBOUND"
      ]
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    }
  }
}
