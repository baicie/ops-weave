{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/ai-run-event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "seq",
    "type",
    "occurredAt",
    "payloadVersion",
    "payload"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000000
    },
    "type": {
      "enum": [
        "SUBMITTED",
        "CLAIMED",
        "STATUS_CHANGED",
        "TOOL_WAIT",
        "CANCEL_REQUESTED",
        "RECONCILED",
        "FINISHED"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payloadVersion": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "PENDING",
            "RUNNING",
            "WAITING_TOOL",
            "SUCCEEDED",
            "FAILED",
            "CANCELLED"
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "reason": {
          "enum": [
            "RUNTIME_UNAVAILABLE",
            "DEADLINE",
            "BUDGET_EXHAUSTED",
            "AUTHORIZATION_REVOKED",
            "RESULT_LOST",
            "EXECUTION_FAILED",
            "CANCELLED_BY_REQUEST"
          ]
        },
        "disclosure": {
          "$ref": "ai-run-reconciliation.schema.json"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "SUBMITTED"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "status",
              "attempt"
            ],
            "properties": {
              "status": {
                "const": "PENDING"
              },
              "attempt": {
                "const": 0
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "reason"
                  ]
                },
                {
                  "required": [
                    "disclosure"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "CLAIMED"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "status",
              "attempt"
            ],
            "properties": {
              "status": {
                "const": "RUNNING"
              },
              "attempt": {
                "minimum": 1
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "reason"
                  ]
                },
                {
                  "required": [
                    "disclosure"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "TOOL_WAIT"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "WAITING_TOOL"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "attempt"
                  ]
                },
                {
                  "required": [
                    "reason"
                  ]
                },
                {
                  "required": [
                    "disclosure"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "STATUS_CHANGED"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "RUNNING",
                  "WAITING_TOOL"
                ]
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "attempt"
                  ]
                },
                {
                  "required": [
                    "reason"
                  ]
                },
                {
                  "required": [
                    "disclosure"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "CANCEL_REQUESTED"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "maxProperties": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "RECONCILED"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "disclosure"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "status"
                  ]
                },
                {
                  "required": [
                    "attempt"
                  ]
                },
                {
                  "required": [
                    "reason"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "FINISHED"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "SUCCEEDED",
                  "FAILED",
                  "CANCELLED"
                ]
              }
            },
            "not": {
              "required": [
                "attempt"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "FINISHED"
          },
          "payload": {
            "properties": {
              "status": {
                "enum": [
                  "FAILED",
                  "CANCELLED"
                ]
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "reason"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "FINISHED"
          },
          "payload": {
            "properties": {
              "status": {
                "const": "SUCCEEDED"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "not": {
              "required": [
                "reason"
              ]
            }
          }
        }
      }
    }
  ]
}
