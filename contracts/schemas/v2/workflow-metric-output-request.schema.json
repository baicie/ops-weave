{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,47}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "previewId": {
      "type": "string",
      "format": "uuid"
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "sourceKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "timestamp",
          "sourceKey",
          "value"
        ]
      }
    }
  },
  "required": [
    "requestId",
    "id",
    "revision",
    "digest",
    "previewId",
    "samples"
  ]
}
