{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Complete window log record with stable source collection position",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "index",
    "position",
    "eventTime",
    "body",
    "severityText",
    "serviceName",
    "traceId",
    "spanId"
  ],
  "properties": {
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 999
    },
    "position": {
      "type": "string",
      "format": "date-time",
      "maxLength": 80
    },
    "eventTime": {
      "type": "string",
      "format": "date-time",
      "maxLength": 80
    },
    "body": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "severityText": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "serviceName": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "traceId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{32}$"
    },
    "spanId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{16}$"
    }
  }
}
