{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/skill-content.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "executionTemplate",
    "prompt",
    "outputSchema",
    "allowedTools",
    "knowledgeScope",
    "modelPolicyRef",
    "sideEffects",
    "maxToolCalls",
    "maxEvidence",
    "maxContextBytes",
    "deadlineMs",
    "tests"
  ],
  "properties": {
    "executionTemplate": {
      "enum": [
        "readonly-current-incident-diagnosis-v1",
        "readonly-incident-diagnosis-v1"
      ]
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "\\S"
    },
    "outputSchema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768,
      "pattern": "\\S"
    },
    "allowedTools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.]{0,31}@[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$"
      }
    },
    "knowledgeScope": {
      "const": "current"
    },
    "modelPolicyRef": {
      "const": "reasoning-structured-readonly"
    },
    "sideEffects": {
      "const": "forbidden"
    },
    "maxToolCalls": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "maxEvidence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "maxContextBytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65536
    },
    "deadlineMs": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 60000
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "expectedOutput"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          },
          "expectedOutput": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "\\S"
          }
        }
      }
    }
  },
  "description": "Inline authoring content. Bounds admit drafts that may fail deterministic template/tool checks. outputSchema and expectedOutput are JSON text, never fetched or executed. Application also rejects duplicate test IDs and applies Java UTF-16 limits to outputSchema/expectedOutput."
}
