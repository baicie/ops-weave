{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/skill-check.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "skillId",
    "version",
    "contentDigest",
    "result",
    "cases",
    "modelComparison"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "skillId": {
      "$ref": "skill-common.schema.json#/$defs/skillId"
    },
    "version": {
      "$ref": "skill-common.schema.json#/$defs/version"
    },
    "contentDigest": {
      "$ref": "skill-common.schema.json#/$defs/digest"
    },
    "result": {
      "enum": [
        "PASSED",
        "FAILED"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "result",
          "detail"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "result": {
            "enum": [
              "PASSED",
              "FAILED"
            ]
          },
          "detail": {
            "enum": [
              "OK",
              "SCHEMA_INVALID",
              "SCHEMA_REMOTE_REF",
              "SCHEMA_NOT_OBJECT",
              "EXPECTED_NOT_JSON",
              "EXPECTED_NOT_OBJECT",
              "EXPECTED_MISSING_MEMBER",
              "EXPECTED_UNKNOWN_MEMBER",
              "EXPECTED_TYPE_MISMATCH",
              "TEMPLATE_LIMIT_EXCEEDED",
              "TOOLS_NOT_ALLOWED",
              "CONTENT_REFERENCE_FORBIDDEN",
              "SECRET_MARKER"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "result": {
                  "const": "PASSED"
                }
              }
            },
            "then": {
              "properties": {
                "detail": {
                  "const": "OK"
                }
              }
            },
            "else": {
              "properties": {
                "detail": {
                  "not": {
                    "const": "OK"
                  }
                }
              }
            }
          }
        ]
      }
    },
    "modelComparison": {
      "const": "not-run"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "PASSED"
          }
        }
      },
      "then": {
        "properties": {
          "cases": {
            "items": {
              "properties": {
                "result": {
                  "const": "PASSED"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "cases": {
            "contains": {
              "properties": {
                "result": {
                  "const": "FAILED"
                }
              },
              "required": [
                "result"
              ]
            }
          }
        }
      }
    }
  ]
}
