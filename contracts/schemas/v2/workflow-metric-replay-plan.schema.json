                  "mapping_id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_.:/%\\-]{1,128}$(?![\\s\\S])"
                  },
                  "mapping_revision": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_.:/%\\-]{1,128}$(?![\\s\\S])"
                  },
                  "mapping_digest": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_.:/%\\-]{1,128}$(?![\\s\\S])"
                  },
                  "workflow_id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_.:/%\\-]{1,128}$(?![\\s\\S])"
