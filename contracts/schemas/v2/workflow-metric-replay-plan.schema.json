      "const": "2.0"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$(?![\\s\\S])"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
