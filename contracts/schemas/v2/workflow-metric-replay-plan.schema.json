                },
                "source_instance_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_.:/%\\-]{1,128}$(?![\\s\\S])"
                },
                "external_item_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_.:/%\\-]{1,128}$(?![\\s\\S])"
                },
                "host_external_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_.:/%\\-]{1,128}$(?![\\s\\S])"
                },
                "metric_key": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_.:/%\\-]{1,128}$(?![\\s\\S])"
                },
                "unit": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_.:/%\\-]{1,128}$(?![\\s\\S])"
                },
                "mapping_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_.:/%\\-]{1,128}$(?![\\s\\S])"
                },
                "mapping_revision": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_.:/%\\-]{1,128}$(?![\\s\\S])"
                },
                "mapping_digest": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_.:/%\\-]{1,128}$(?![\\s\\S])"
