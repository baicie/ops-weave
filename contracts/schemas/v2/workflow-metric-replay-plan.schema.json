      "maxLength": 30,
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3}(?:\\d{3}(?:\\d{3})?)?)?Z$(?![\\s\\S])"
    },
    "till": {
      "type": "string",
      "format": "date-time",
      "maxLength": 30,
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3}(?:\\d{3}(?:\\d{3})?)?)?Z$(?![\\s\\S])"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 30,
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3}(?:\\d{3}(?:\\d{3})?)?)?Z$(?![\\s\\S])"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 30,
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3}(?:\\d{3}(?:\\d{3})?)?)?Z$(?![\\s\\S])"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "maxLength": 30,
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3}(?:\\d{3}(?:\\d{3})?)?)?Z$(?![\\s\\S])"
    },
    "purpose": {
      "const": "REBUILD_METRIC_PROJECTION"
    },
    "outputPolicy": {
      "const": "ISOLATED_METRIC_SERIES"
    },
    "notifications": {
      "const": false
    },
    "actions": {
      "const": false
    },
    "state": {
      "enum": [
        "PREPARING",
        "READY",
