                  "external_item_id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_.:/%\\-]{1,128}$(?![\\s\\S])"
                  },
                  "host_external_id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_.:/%\\-]{1,128}$(?![\\s\\S])"
