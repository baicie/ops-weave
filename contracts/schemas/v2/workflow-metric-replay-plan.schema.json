      "if": {
        "properties": {
          "state": {
            "const": "FAILED"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "enum": [
              "FORBIDDEN",
              "SOURCE_UNAVAILABLE",
              "SOURCE_CHANGED",
              "MAPPING_CHANGED",
