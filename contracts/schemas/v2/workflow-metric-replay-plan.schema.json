                },
                "data_mode": {
                  "const": "zabbix-jsonrpc"
                },
                "collection_mode": {
                  "const": "REPLAY_60S"
                },
                "replay_id": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$(?![\\s\\S])"
                }
              },
              "patternProperties": {
                "^dim_[A-Za-z_][A-Za-z0-9_]{0,59}$": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_.:/%\\-]{1,128}$(?![\\s\\S])"
