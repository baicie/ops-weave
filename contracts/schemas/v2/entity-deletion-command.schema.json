{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/entity-deletion-command.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "entityId",
    "reason"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "entityId": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    }
  }
}
