{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.opsweave.invalid/v2/workflow-quality-alert-command",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "requestId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "expectedVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 999999
    },
    "windowSeconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 86400
    },
    "rules": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "workflow-quality-alert-rule.schema.json"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "SOURCE_FAILURES"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "OUTPUT_REJECTIONS"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "QUEUE_WAIT"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "TASK_FAILURE"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        }
      ]
    }
  },
  "required": [
    "requestId",
    "id",
    "revision",
    "digest",
    "expectedVersion",
    "windowSeconds",
    "rules"
  ]
}
