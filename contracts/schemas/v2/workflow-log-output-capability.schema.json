{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "mode": {
      "enum": [
        "MANUAL_LOG_BATCH",
        "SOURCE_LOG_SAMPLE"
      ]
    },
    "available": {
      "type": "boolean"
    },
    "maxRecords": {
      "const": 5
    },
    "readAllowed": {
      "type": "boolean"
    },
    "writeAllowed": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "mode",
    "available",
    "maxRecords",
    "readAllowed",
    "writeAllowed"
  ]
}
