{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "maxBatches": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "consumedBatches": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    }
  },
  "required": [
    "id",
    "issuedAt",
    "expiresAt",
    "maxBatches",
    "consumedBatches"
  ]
}
