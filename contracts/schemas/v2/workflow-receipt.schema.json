{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/workflow-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "digest",
    "inputDigest",
    "origin",
    "accepted",
    "rejected",
    "filtered",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "inputDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "origin": {
      "enum": [
        "MANUAL_SAMPLE",
        "fixture",
        "zabbix-jsonrpc"
      ]
    },
    "accepted": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "rejected": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "filtered": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
