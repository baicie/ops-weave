{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsweave.dev/schemas/v2/ai-run-cancel-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "runId",
    "requestedAt",
    "recorded",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time"
    },
    "recorded": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "PENDING",
        "RUNNING",
        "WAITING_TOOL",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ]
    }
  }
}
