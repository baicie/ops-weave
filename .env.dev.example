# Copy to .env.dev (ignored by Git). Values are literal: no ${...} expansion.
# A shared .env and optional .env.dev.platform/runtime/worker/web are also read.
# Environment variables set in your terminal have the highest priority.

# Local platform with an existing PostgreSQL. Set real local credentials below.
OPSWEAVE_AUTH_MODE=dev
OPSWEAVE_DEV_TOKEN=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
# Go manager enables automatic local Web sessions; the token stays in Vite's server.
# Set false in .env.dev.web to use the manual development form.
# OPSWEAVE_WEB_LOCAL_SESSION=false
OPSWEAVE_INVENTORY_STORE=postgres
OPSWEAVE_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/opsweave
OPSWEAVE_JDBC_USER=opsweave_dev
OPSWEAVE_JDBC_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD

# Source stays closed until explicitly configured. Failure never selects Fixture.
OPSWEAVE_ZABBIX_MODE=closed
# OPSWEAVE_ZABBIX_MODE=jsonrpc
# OPSWEAVE_ZABBIX_URL=http://127.0.0.1:18088/api_jsonrpc.php
# OPSWEAVE_ZABBIX_TOKEN=REPLACE_WITH_READONLY_TOKEN
# OPSWEAVE_VICTORIAMETRICS_URL=http://127.0.0.1:8428

# Runtime business endpoints stay closed until explicitly configured.
OPSWEAVE_MODE=closed
OPSWEAVE_PROVIDER=mock
OPSWEAVE_ALLOW_MODEL_EGRESS=false
# OPSWEAVE_MODE=platform-dev
# OPSWEAVE_PLATFORM_URL=http://127.0.0.1:8080
# OPSWEAVE_RUNTIME_URL=http://127.0.0.1:8090
# OPSWEAVE_RUNTIME_KEY=REPLACE_WITH_SEPARATE_RANDOM_RUNTIME_KEY
# OPSWEAVE_SKILL_DIR=extensions/skills/incident-diagnosis-current

# Starting the Worker process does not enable collection.
OPSWEAVE_HISTORY_ENABLED=false
OPSWEAVE_HISTORY_SCHEMA_MODE=verify
# Configure authorized streams/identities using .env.example and the Worker runbook.
# Keep stream names and initial timestamps fixed when restarting an enabled Worker.
