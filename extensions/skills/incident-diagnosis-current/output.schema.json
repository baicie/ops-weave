{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InsightDraft v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "findings": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "observation",
              "hypothesis"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "kind",
          "statement",
          "evidenceRefs"
        ]
      }
    },
    "missingData": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    }
  },
  "required": [
    "summary",
    "findings",
    "missingData",
    "limitations"
  ]
}
