# Generate real local-only values; do not use these placeholders.
POSTGRES_DB=opsweave
POSTGRES_USER=opsweave_dev
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_VALUE
OPSWEAVE_DEV_TOKEN=REPLACE_WITH_RANDOM_VALUE
# Closed by default. Local platform-api identity uses an explicit token, never OIDC mock fallback.
# OPSWEAVE_AUTH_MODE=dev
# OPSWEAVE_ZABBIX_MODE=fixture
# Live JSON-RPC (no fixture fallback):
# OPSWEAVE_ZABBIX_MODE=jsonrpc
# OPSWEAVE_ZABBIX_URL=http://127.0.0.1:8080/api_jsonrpc.php
# OPSWEAVE_ZABBIX_TOKEN=REPLACE_WITH_RANDOM_VALUE
# PostgreSQL is the inventory default. Memory is an explicit test double, not a fallback.
# OPSWEAVE_INVENTORY_STORE=postgres
# OPSWEAVE_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/opsweave
# OPSWEAVE_JDBC_USER=opsweave_dev
# OPSWEAVE_JDBC_PASSWORD=REPLACE_WITH_RANDOM_VALUE
# Product metric queries read VictoriaMetrics. Empty leaves the query API closed.
# OPSWEAVE_VICTORIAMETRICS_URL=http://127.0.0.1:8428
# External inference is opt-in, never enabled in the default demo script.
# OPSWEAVE_PROVIDER=rig-openai
# OPSWEAVE_ALLOW_MODEL_EGRESS=true
# OPSWEAVE_LLM_MODEL=<your-authorized-model>
# OPENAI_API_KEY=<secret-not-in-git>
# Optional single-stream history worker. Closed unless explicitly enabled; loopback development only.
# OPSWEAVE_HISTORY_ENABLED=true
# OPSWEAVE_HISTORY_PLATFORM_URL=http://127.0.0.1:8080
# OPSWEAVE_HISTORY_PLATFORM_TOKEN=REPLACE_WITH_RANDOM_VALUE
# OPSWEAVE_HISTORY_DATA_MODE=zabbix-jsonrpc
# OPSWEAVE_HISTORY_ITEM_ID=20001
# OPSWEAVE_HISTORY_STREAM=history-v1
# OPSWEAVE_HISTORY_INITIAL_FROM=<UTC_UNIX_SECONDS>
# OPSWEAVE_HISTORY_VICTORIA_URL=http://127.0.0.1:8428
# OPSWEAVE_HISTORY_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/opsweave
# OPSWEAVE_HISTORY_JDBC_USER=opsweave_dev
# OPSWEAVE_HISTORY_JDBC_PASSWORD=REPLACE_WITH_RANDOM_VALUE
